digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="1.05", splines=polyline, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#6B7280", arrowsize=0.6];
contracts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contracts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="primary_tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK primary_tenant_id</FONT></TD></TR><TR><TD PORT="start_date" ALIGN="LEFT"><FONT POINT-SIZE="12">start_date</FONT></TD></TR><TR><TD PORT="end_date" ALIGN="LEFT"><FONT POINT-SIZE="12">end_date</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
meter_readings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>meter_readings</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id</FONT></TD></TR><TR><TD PORT="billing_period" ALIGN="LEFT"><FONT POINT-SIZE="12">billing_period</FONT></TD></TR><TR><TD PORT="old_index" ALIGN="LEFT"><FONT POINT-SIZE="12">old_index</FONT></TD></TR><TR><TD PORT="new_index" ALIGN="LEFT"><FONT POINT-SIZE="12">new_index</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
invoices [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>invoices</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="billing_period" ALIGN="LEFT"><FONT POINT-SIZE="12">billing_period</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
invoice_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>invoice_items</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="invoice_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK invoice_id</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id</FONT></TD></TR><TR><TD PORT="meter_reading_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK meter_reading_id</FONT></TD></TR><TR><TD PORT="quantity" ALIGN="LEFT"><FONT POINT-SIZE="12">quantity</FONT></TD></TR></TABLE>>];
payment_transactions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>payment_transactions</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="invoice_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK invoice_id</FONT></TD></TR><TR><TD PORT="amount" ALIGN="LEFT"><FONT POINT-SIZE="12">amount</FONT></TD></TR><TR><TD PORT="received_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK received_by</FONT></TD></TR></TABLE>>];
checkout_records [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>checkout_records</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="settled_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK settled_by</FONT></TD></TR></TABLE>>];
contracts:id -> checkout_records:contract_id [dir=both, arrowtail=tee, arrowhead=tee];
invoices:id -> invoice_items:invoice_id [dir=both, arrowtail=tee, arrowhead=crow];
meter_readings:id -> invoice_items:meter_reading_id [dir=both, arrowtail=tee, arrowhead=tee];
contracts:id -> invoices:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> meter_readings:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
invoices:id -> payment_transactions:invoice_id [dir=both, arrowtail=tee, arrowhead=crow];
}
