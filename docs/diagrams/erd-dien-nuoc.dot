digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="1.05", splines=polyline, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#6B7280", arrowsize=0.6];
properties [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>properties</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
service_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>service_items</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR></TABLE>>];
service_price_configs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>service_price_configs</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id</FONT></TD></TR><TR><TD PORT="unit_price" ALIGN="LEFT"><FONT POINT-SIZE="12">unit_price</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from</FONT></TD></TR></TABLE>>];
contracts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contracts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="primary_tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK primary_tenant_id</FONT></TD></TR><TR><TD PORT="start_date" ALIGN="LEFT"><FONT POINT-SIZE="12">start_date</FONT></TD></TR><TR><TD PORT="end_date" ALIGN="LEFT"><FONT POINT-SIZE="12">end_date</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
meter_readings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>meter_readings</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id</FONT></TD></TR><TR><TD PORT="billing_period" ALIGN="LEFT"><FONT POINT-SIZE="12">billing_period</FONT></TD></TR><TR><TD PORT="old_index" ALIGN="LEFT"><FONT POINT-SIZE="12">old_index</FONT></TD></TR><TR><TD PORT="new_index" ALIGN="LEFT"><FONT POINT-SIZE="12">new_index</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
consumption_alerts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>consumption_alerts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="meter_reading_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK meter_reading_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="checked_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK checked_by</FONT></TD></TR></TABLE>>];
meter_readings:id -> consumption_alerts:meter_reading_id [dir=both, arrowtail=tee, arrowhead=tee];
contracts:id -> meter_readings:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
service_items:id -> meter_readings:service_item_id [dir=both, arrowtail=tee, arrowhead=crow];
properties:id -> service_price_configs:property_id [dir=both, arrowtail=tee, arrowhead=crow];
service_items:id -> service_price_configs:service_item_id [dir=both, arrowtail=tee, arrowhead=crow];
}
