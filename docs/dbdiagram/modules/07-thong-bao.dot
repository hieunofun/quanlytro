"billing_documents" [id="table-billing_documents",tooltip="Đầu chứng từ tháng/phát sinh/bồi thường/điều chỉnh/phải hoàn",label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="4" PORT="header" ALIGN="LEFT" BGCOLOR="#64748B"><FONT FACE="Arial" COLOR="#FFFFFF" POINT-SIZE="17"><B>billing_documents</B></FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F1F5F9"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="11">THAM CHIẾU · rút gọn 2/16 cột</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">PK</FONT></TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033"><B>id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">UQ</FONT></TD><TD PORT="document_code" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">document_code</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">varchar(80)</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR></TABLE>>];
"consumption_alerts" [id="table-consumption_alerts",tooltip="Lần đánh giá, baseline và xác nhận có căn cứ",label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="4" PORT="header" ALIGN="LEFT" BGCOLOR="#64748B"><FONT FACE="Arial" COLOR="#FFFFFF" POINT-SIZE="17"><B>consumption_alerts</B></FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F1F5F9"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="11">THAM CHIẾU · rút gọn 2/12 cột</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">PK</FONT></TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033"><B>id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">&#160;</FONT></TD><TD PORT="status" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">status</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">varchar(30)</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR></TABLE>>];
