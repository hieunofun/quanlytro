digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="1.05", splines=polyline, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#6B7280", arrowsize=0.6];
properties [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>properties</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
rooms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>rooms</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR></TABLE>>];
contracts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contracts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="reservation_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK reservation_id</FONT></TD></TR><TR><TD PORT="previous_contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK previous_contract_id</FONT></TD></TR><TR><TD PORT="start_date" ALIGN="LEFT"><FONT POINT-SIZE="12">start_date</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="created_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK created_by</FONT></TD></TR></TABLE>>];
service_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>service_items</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR></TABLE>>];
service_price_configs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>service_price_configs</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from</FONT></TD></TR><TR><TD PORT="unit_price" ALIGN="LEFT"><FONT POINT-SIZE="12">unit_price</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
contract_service_subscriptions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contract_service_subscriptions</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from</FONT></TD></TR><TR><TD PORT="quantity" ALIGN="LEFT"><FONT POINT-SIZE="12">quantity</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
meters [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>meters</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
meter_readings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>meter_readings</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="correction_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK correction_item_id</FONT></TD></TR><TR><TD PORT="meter_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK meter_id</FONT></TD></TR><TR><TD PORT="supersedes_reading_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK supersedes_reading_id</FONT></TD></TR><TR><TD PORT="handover_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK handover_id</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
consumption_segments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>consumption_segments</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="start_reading_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK start_reading_id</FONT></TD></TR><TR><TD PORT="end_reading_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK end_reading_id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="supersedes_segment_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK supersedes_segment_id</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
alert_policies [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>alert_policies</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from</FONT></TD></TR></TABLE>>];
consumption_alerts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>consumption_alerts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="segment_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK segment_id</FONT></TD></TR><TR><TD PORT="policy_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK policy_id</FONT></TD></TR><TR><TD PORT="supersedes_alert_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK supersedes_alert_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="checked_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK checked_by</FONT></TD></TR></TABLE>>];
alert_baseline_sources [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>alert_baseline_sources</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="alert_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK alert_id</FONT></TD></TR><TR><TD PORT="source_segment_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK source_segment_id</FONT></TD></TR></TABLE>>];
consumption_alerts:id -> alert_baseline_sources:alert_id [dir=both, arrowtail=tee, arrowhead=crow];
consumption_segments:id -> alert_baseline_sources:source_segment_id [dir=both, arrowtail=tee, arrowhead=crow];
properties:id -> alert_policies:property_id [dir=both, arrowtail=tee, arrowhead=crow];
rooms:id -> alert_policies:room_id [dir=both, arrowtail=tee, arrowhead=crow];
service_items:id -> alert_policies:service_item_id [dir=both, arrowtail=tee, arrowhead=crow];
alert_policies:id -> consumption_alerts:policy_id [dir=both, arrowtail=tee, arrowhead=crow];
consumption_segments:id -> consumption_alerts:segment_id [dir=both, arrowtail=tee, arrowhead=crow];
consumption_alerts:id -> consumption_alerts:supersedes_alert_id [dir=both, arrowtail=tee, arrowhead=tee];
contracts:id -> consumption_segments:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
meter_readings:id -> consumption_segments:end_reading_id [dir=both, arrowtail=tee, arrowhead=crow];
meter_readings:id -> consumption_segments:start_reading_id [dir=both, arrowtail=tee, arrowhead=crow];
consumption_segments:id -> consumption_segments:supersedes_segment_id [dir=both, arrowtail=tee, arrowhead=tee];
contracts:id -> contract_service_subscriptions:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
service_items:id -> contract_service_subscriptions:service_item_id [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> contracts:previous_contract_id [dir=both, arrowtail=tee, arrowhead=crow];
rooms:id -> contracts:room_id [dir=both, arrowtail=tee, arrowhead=crow];
meters:id -> meter_readings:meter_id [dir=both, arrowtail=tee, arrowhead=crow];
meter_readings:id -> meter_readings:supersedes_reading_id [dir=both, arrowtail=tee, arrowhead=tee];
rooms:id -> meters:room_id [dir=both, arrowtail=tee, arrowhead=crow];
service_items:id -> meters:service_item_id [dir=both, arrowtail=tee, arrowhead=crow];
properties:id -> rooms:property_id [dir=both, arrowtail=tee, arrowhead=crow];
properties:id -> service_price_configs:property_id [dir=both, arrowtail=tee, arrowhead=crow];
service_items:id -> service_price_configs:service_item_id [dir=both, arrowtail=tee, arrowhead=crow];
}
