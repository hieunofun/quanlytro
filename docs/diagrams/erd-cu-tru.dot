digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="1.05", splines=polyline, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#6B7280", arrowsize=0.6];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>users</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
tenant_profiles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>tenant_profiles</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK user_id</FONT></TD></TR></TABLE>>];
properties [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>properties</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
rooms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>rooms</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR></TABLE>>];
contracts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contracts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="reservation_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK reservation_id</FONT></TD></TR><TR><TD PORT="previous_contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK previous_contract_id</FONT></TD></TR><TR><TD PORT="start_date" ALIGN="LEFT"><FONT POINT-SIZE="12">start_date</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="created_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK created_by</FONT></TD></TR></TABLE>>];
contract_parties [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contract_parties</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK tenant_id</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from</FONT></TD></TR></TABLE>>];
contract_contacts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contract_contacts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK tenant_id</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from</FONT></TD></TR><TR><TD PORT="authorized_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK authorized_by</FONT></TD></TR></TABLE>>];
contract_residencies [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contract_residencies</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK tenant_id</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
contract_terms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contract_terms</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from</FONT></TD></TR><TR><TD PORT="approved_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK approved_by</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
room_possessions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>room_possessions</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
handovers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>handovers</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="possession_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK possession_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="given_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK given_by</FONT></TD></TR><TR><TD PORT="received_by_tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK received_by_tenant_id</FONT></TD></TR><TR><TD PORT="confirmed_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK confirmed_by</FONT></TD></TR></TABLE>>];
handover_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>handover_items</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="handover_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK handover_id</FONT></TD></TR><TR><TD PORT="asset_placement_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK asset_placement_id</FONT></TD></TR><TR><TD PORT="quantity" ALIGN="LEFT"><FONT POINT-SIZE="12">quantity</FONT></TD></TR></TABLE>>];
checkout_records [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>checkout_records</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="return_handover_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK return_handover_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="approved_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK approved_by</FONT></TD></TR></TABLE>>];
users:id -> checkout_records:approved_by [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> checkout_records:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
handovers:id -> checkout_records:return_handover_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> contract_contacts:authorized_by [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> contract_contacts:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
tenant_profiles:id -> contract_contacts:tenant_id [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> contract_parties:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
tenant_profiles:id -> contract_parties:tenant_id [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> contract_residencies:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> contract_residencies:recorded_by [dir=both, arrowtail=tee, arrowhead=crow];
tenant_profiles:id -> contract_residencies:tenant_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> contract_terms:approved_by [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> contract_terms:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> contracts:created_by [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> contracts:previous_contract_id [dir=both, arrowtail=tee, arrowhead=crow];
rooms:id -> contracts:room_id [dir=both, arrowtail=tee, arrowhead=crow];
handovers:id -> handover_items:handover_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> handovers:confirmed_by [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> handovers:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> handovers:given_by [dir=both, arrowtail=tee, arrowhead=crow];
room_possessions:id -> handovers:possession_id [dir=both, arrowtail=tee, arrowhead=crow];
tenant_profiles:id -> handovers:received_by_tenant_id [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> room_possessions:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> room_possessions:recorded_by [dir=both, arrowtail=tee, arrowhead=crow];
properties:id -> rooms:property_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> tenant_profiles:user_id [dir=both, arrowtail=tee, arrowhead=tee];
}
