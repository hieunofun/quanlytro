// 08 · Tệp đính kèm — một phần của model49 / V13.
// Bảng chính giữ đủ cột; bảng ngoài nhóm chỉ là THAM CHIẾU RÚT GỌN.
// Chỉ gồm FK có bảng nguồn thuộc nhóm. Không mở rộng đệ quy từ bảng tham chiếu.
// Không dùng file từng phần để tạo lại database.
Project Tep {
  database_type: 'PostgreSQL'
  Note: 'Tệp đính kèm: 2 bảng chính đầy đủ và 11 bảng tham chiếu rút gọn. 13 FK thật có bảng nguồn thuộc nhóm. Bảng xám chỉ hiện PK/cột đích FK và một mã/tên có thật để nhận diện; không phải toàn bộ định nghĩa bảng. Bản chuẩn đầy đủ: docs/quanlytro.dbml.'
}

Table stored_files [headercolor: #4D7C0F] {
  id bigint [pk, not null, increment]
  storage_key varchar(255) [not null, unique]
  original_name varchar(255) [not null]
  content_type varchar(100) [not null]
  size_bytes bigint
  sha256 varchar(64)
  external_url text
  uploaded_by bigint [not null]
  uploaded_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((external_url IS NOT NULL) OR ((sha256 IS NOT NULL) AND (size_bytes IS NOT NULL)))` [name: 'stored_files_check']
    `(size_bytes > 0)` [name: 'stored_files_size_bytes_check']
  }

  Note: 'Tệp và metadata, không chứa file thay đổi dưới cùng key'
}

Table file_attachments [headercolor: #4D7C0F] {
  id bigint [pk, not null, increment]
  file_id bigint [not null]
  room_id bigint
  asset_id bigint
  handover_item_id bigint
  meter_reading_id bigint
  maintenance_request_id bigint
  maintenance_cost_id bigint
  contract_term_id bigint
  billing_document_id bigint
  violation_id bigint
  fund_entry_id bigint
  caption text [not null, default: '']
  sort_order integer [not null, default: 0]
  attached_by bigint [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `(num_nonnulls(room_id, asset_id, handover_item_id, meter_reading_id, maintenance_request_id, maintenance_cost_id, contract_term_id, billing_document_id, violation_id, fund_entry_id) = 1)` [name: 'file_attachments_check']
  }

  Note: 'Một liên kết tới một đối tượng bằng FK thật'
}

// THAM CHIẾU: assets — 2/6 cột thật.
Table assets [headercolor: #64748B] {
  id bigint [pk, not null, increment]
  asset_code varchar(50) [not null, unique]
  Note: 'THAM CHIẾU RÚT GỌN · Bảng thuộc nhóm khác. Chỉ hiện 2/6 cột để đọc quan hệ; không hiện các FK xuất phát từ bảng này. Định nghĩa đầy đủ trong docs/quanlytro.dbml.'
}

