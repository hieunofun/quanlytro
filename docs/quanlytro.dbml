// Thiết kế mục tiêu bước 1–2. Nguồn: quanlytro.sql + database-rules.sql.
// 49 bảng V13; nguồn là metadata PostgreSQL đã thực thi. Tổng và số dư tính bằng view.
Project QuanLyNhaTro {
  database_type: 'PostgreSQL'
}

Table users [headercolor: #315775] {
  id bigint [pk, not null, increment]
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((role)::text = ANY ((ARRAY['ADMIN'::character varying, 'STAFF'::character varying, 'TENANT'::character varying])::text[]))` [name: 'users_role_check']
    `((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'LOCKED'::character varying, 'INACTIVE'::character varying])::text[]))` [name: 'users_status_check']
    `(btrim((username)::text) <> ''::text)` [name: 'users_username_check']
  }
}

Table tenant_profiles [headercolor: #315775] {
  id bigint [pk, not null, increment]
  user_id bigint [unique]
  full_name varchar(150) [not null]
  identity_number varchar(30) [unique]
  phone varchar(30)
  email varchar(150)
  date_of_birth date
  hometown text
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `(btrim((full_name)::text) <> ''::text)` [name: 'tenant_profiles_full_name_check']
    `((identity_number IS NULL) OR (btrim((identity_number)::text) <> ''::text))` [name: 'tenant_profiles_identity_number_check']
  }
}

Table employee_assignments [headercolor: #315775] {
  id bigint [pk, not null, increment]
  user_id bigint [not null]
  property_id bigint
  room_id bigint
  assigned_at timestamptz [not null, default: `clock_timestamp()`]
  revoked_at timestamptz

  checks {
    `(num_nonnulls(property_id, room_id) = 1)` [name: 'employee_assignments_check']
    `((revoked_at IS NULL) OR (revoked_at >= assigned_at))` [name: 'employee_assignments_check1']
  }

  Note: 'PostgreSQL: CREATE UNIQUE INDEX uq_active_assignment_property ON public.employee_assignments USING btree (user_id, property_id) WHERE ((revoked_at IS NULL) AND (property_id IS NOT NULL)); CREATE UNIQUE INDEX uq_active_assignment_room ON public.employee_assignments USING btree (user_id, room_id) WHERE ((revoked_at IS NULL) AND (room_id IS NOT NULL))'
}

Table staff_permission_grants [headercolor: #315775] {
  id bigint [pk, not null, increment]
  assignment_id bigint [not null]
  action_code varchar(40) [not null]
  amount_limit numeric(14,2)
  expires_at timestamptz
  granted_by bigint [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (assignment_id, action_code) [name: 'staff_permission_grants_assignment_id_action_code_key', unique, type: btree]
  }

  checks {
    `((action_code)::text = ANY ((ARRAY['MANAGE'::character varying, 'BILLING'::character varying, 'RECEIVE'::character varying, 'REFUND'::character varying, 'DEPOSIT_OFFSET'::character varying, 'TRANSFER'::character varying, 'ADJUST'::character varying, 'WAIVE_DEPOSIT'::character varying, 'MAINTENANCE'::character varying])::text[]))` [name: 'staff_permission_grants_action_code_check']
    `(amount_limit >= (0)::numeric)` [name: 'staff_permission_grants_amount_limit_check']
  }
}

Table password_reset_tokens [headercolor: #315775] {
  id bigint [pk, not null, increment]
  user_id bigint [not null]
  token_hash varchar(64) [not null, unique]
  issued_by bigint [not null]
  expires_at timestamptz [not null]
  used_at timestamptz
  attempts smallint [not null, default: 0]
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((attempts >= 0) AND (attempts <= 5))` [name: 'password_reset_tokens_attempts_check']
    `(expires_at > created_at)` [name: 'password_reset_tokens_check']
  }
}

Table audit_events [headercolor: #315775] {
  id bigint [pk, not null, increment]
  actor_user_id bigint
  actor_type varchar(10) [not null, default: 'USER']
  action varchar(80) [not null]
  resource_type varchar(80) [not null]
  resource_id varchar(100)
  before_data jsonb
  after_data jsonb
  reason text
  recorded_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((actor_type)::text = ANY ((ARRAY['USER'::character varying, 'SYSTEM'::character varying])::text[]))` [name: 'audit_events_actor_type_check']
    `(((actor_type)::text = 'USER'::text) = (actor_user_id IS NOT NULL))` [name: 'audit_events_check']
  }
}

Table properties [headercolor: #315775] {
  id bigint [pk, not null, increment]
  property_code varchar(30) [not null, unique]
  name varchar(150) [not null]
  address text [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  meter_cutoff_day smallint [not null, default: 28]
  invoice_issue_day smallint [not null, default: 1]
  collection_timing varchar(20) [not null, default: 'IN_ADVANCE']
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((collection_timing)::text = ANY ((ARRAY['IN_ADVANCE'::character varying, 'IN_ARREARS'::character varying])::text[]))` [name: 'properties_collection_timing_check']
    `((invoice_issue_day >= 1) AND (invoice_issue_day <= 31))` [name: 'properties_invoice_issue_day_check']
    `((meter_cutoff_day >= 1) AND (meter_cutoff_day <= 31))` [name: 'properties_meter_cutoff_day_check']
    `((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'INACTIVE'::character varying])::text[]))` [name: 'properties_status_check']
  }
}

Table rooms [headercolor: #315775] {
  id bigint [pk, not null, increment]
  property_id bigint [not null]
  floor_number smallint [not null, default: 1]
  room_code varchar(30) [not null]
  max_occupants smallint [not null, default: 2]
  area_sqm numeric(8,2)
  description text [not null, default: '']
  internal_note text [not null, default: '']
  opened_on date [not null, default: `CURRENT_DATE`]
  retired_on date

  indexes {
    (property_id, room_code) [name: 'rooms_property_id_room_code_key', unique, type: btree]
  }

  checks {
    `(area_sqm > (0)::numeric)` [name: 'rooms_area_sqm_check']
    `(retired_on >= opened_on)` [name: 'rooms_check']
    `(floor_number >= 0)` [name: 'rooms_floor_number_check']
    `(max_occupants > 0)` [name: 'rooms_max_occupants_check']
  }
}

Table room_price_history [headercolor: #315775] {
  id bigint [pk, not null, increment]
  room_id bigint [not null]
  effective_from date [not null]
  amount numeric(14,2) [not null]
  recorded_by bigint
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (room_id, effective_from) [name: 'room_price_history_room_id_effective_from_key', unique, type: btree]
  }

  checks {
    `(amount >= (0)::numeric)` [name: 'room_price_history_amount_check']
  }
}

Table room_operating_periods [headercolor: #315775] {
  id bigint [pk, not null, increment]
  room_id bigint [not null]
  valid_from timestamptz [not null]
  valid_to timestamptz
  status varchar(20) [not null]
  recorded_by bigint
  note text

  checks {
    `((valid_to IS NULL) OR (valid_to > valid_from))` [name: 'room_operating_periods_check']
    `((status)::text = ANY ((ARRAY['READY'::character varying, 'TURNOVER'::character varying, 'MAINTENANCE'::character varying, 'INACTIVE'::character varying])::text[]))` [name: 'room_operating_periods_status_check']
  }

  Note: 'PostgreSQL: CREATE INDEX room_operating_periods_room_id_tstzrange_excl ON public.room_operating_periods USING gist (room_id, tstzrange(valid_from, valid_to, \'[)\'::text))'
}

Table asset_types [headercolor: #315775] {
  id bigint [pk, not null, increment]
  code varchar(40) [not null, unique]
  name varchar(150) [not null]
  unit_name varchar(30) [not null, default: 'Cái']
}

Table assets [headercolor: #315775] {
  id bigint [pk, not null, increment]
  asset_type_id bigint [not null]
  asset_code varchar(50) [not null, unique]
  quantity numeric(12,2) [not null, default: 1]
  status varchar(20) [not null, default: 'ACTIVE']
  note text

  checks {
    `(quantity > (0)::numeric)` [name: 'assets_quantity_check']
    `((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'RETIRED'::character varying])::text[]))` [name: 'assets_status_check']
  }
}

Table asset_placements [headercolor: #315775] {
  id bigint [pk, not null, increment]
  asset_id bigint [not null]
  room_id bigint
  property_id bigint
  valid_from timestamptz [not null]
  valid_to timestamptz
  recorded_by bigint

  checks {
    `(num_nonnulls(room_id, property_id) = 1)` [name: 'asset_placements_check']
    `((valid_to IS NULL) OR (valid_to > valid_from))` [name: 'asset_placements_check1']
  }

  Note: 'PostgreSQL: CREATE INDEX asset_placements_asset_id_tstzrange_excl ON public.asset_placements USING gist (asset_id, tstzrange(valid_from, valid_to, \'[)\'::text))'
}

Table reservations [headercolor: #315775] {
  id bigint [pk, not null, increment]
  room_id bigint [not null]
  tenant_id bigint
  reservation_code varchar(60) [not null, unique]
  contact_name varchar(150)
  contact_phone varchar(30)
  start_date date [not null]
  end_date date [not null]
  expires_at timestamptz [not null]
  status varchar(20) [not null, default: 'HELD']
  conditions text [not null, default: '']
  created_by bigint
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `(start_date < end_date)` [name: 'reservations_check']
    `((tenant_id IS NOT NULL) OR (btrim((COALESCE(contact_name, ''::character varying))::text) <> ''::text))` [name: 'reservations_check1']
    `((status)::text = ANY ((ARRAY['HELD'::character varying, 'CONVERTED'::character varying, 'CANCELLED'::character varying, 'EXPIRED'::character varying])::text[]))` [name: 'reservations_status_check']
  }
}

Table contracts [headercolor: #315775] {
  id bigint [pk, not null, increment]
  room_id bigint [not null]
  reservation_id bigint [unique]
  previous_contract_id bigint
  continuation_reason varchar(30)
  contract_code varchar(60) [not null, unique]
  start_date date [not null]
  reconciliation_status varchar(20) [not null, default: 'VERIFIED']
  status varchar(20) [not null, default: 'DRAFT']
  created_by bigint
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((previous_contract_id IS NULL) OR (previous_contract_id <> id))` [name: 'contracts_check']
    `((previous_contract_id IS NULL) = (continuation_reason IS NULL))` [name: 'contracts_check1']
    `((continuation_reason IS NULL) OR ((continuation_reason)::text = ANY ((ARRAY['ROOM_TRANSFER'::character varying, 'PARTY_CHANGE'::character varying, 'CONTINUATION'::character varying])::text[])))` [name: 'contracts_continuation_reason_check']
    `((reconciliation_status)::text = ANY ((ARRAY['VERIFIED'::character varying, 'PENDING'::character varying])::text[]))` [name: 'contracts_reconciliation_status_check']
    `((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'PENDING'::character varying, 'ACTIVE'::character varying, 'ENDED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'contracts_status_check']
  }
}

Table contract_parties [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  tenant_id bigint [not null]
  party_role varchar(30) [not null]
  effective_from date [not null]
  effective_to date
  agreement_note text [not null, default: '']

  indexes {
    (contract_id, tenant_id, party_role, effective_from) [name: 'contract_parties_contract_id_tenant_id_party_role_effective_key', unique, type: btree]
    tenant_id [name: 'idx_party_person', type: btree]
  }

  checks {
    `((effective_to IS NULL) OR (effective_to > effective_from))` [name: 'contract_parties_check']
    `((party_role)::text = ANY ((ARRAY['PRIMARY'::character varying, 'GUARANTOR'::character varying, 'WITNESS'::character varying])::text[]))` [name: 'contract_parties_party_role_check']
  }

  Note: 'PostgreSQL: CREATE UNIQUE INDEX uq_primary_party ON public.contract_parties USING btree (contract_id) WHERE ((party_role)::text = \'PRIMARY\'::text)'
}

Table contract_contacts [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  tenant_id bigint [not null]
  contact_role varchar(20) [not null, default: 'PRIMARY']
  effective_from date [not null]
  effective_to date
  can_view_billing boolean [not null, default: false]
  authorized_by bigint

  checks {
    `((effective_to IS NULL) OR (effective_to > effective_from))` [name: 'contract_contacts_check']
    `((contact_role)::text = ANY ((ARRAY['PRIMARY'::character varying, 'BACKUP'::character varying])::text[]))` [name: 'contract_contacts_contact_role_check']
  }

  Note: 'PostgreSQL: CREATE INDEX contract_contacts_contract_id_daterange_excl ON public.contract_contacts USING gist (contract_id, daterange(effective_from, effective_to, \'[)\'::text)) WHERE ((contact_role)::text = \'PRIMARY\'::text)'
}

Table contract_residencies [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  tenant_id bigint [not null]
  effective_from date [not null]
  effective_to date
  relationship varchar(50)
  recorded_by bigint

  indexes {
    tenant_id [name: 'idx_residency_person', type: btree]
  }

  checks {
    `((effective_to IS NULL) OR (effective_to > effective_from))` [name: 'contract_residencies_check']
  }

  Note: 'PostgreSQL: CREATE INDEX contract_residencies_contract_id_tenant_id_daterange_excl ON public.contract_residencies USING gist (contract_id, tenant_id, daterange(effective_from, effective_to, \'[)\'::text))'
}

Table contract_terms [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  version_no integer [not null]
  effective_from date [not null]
  lease_end date [not null]
  rental_price numeric(14,2) [not null]
  deposit_required numeric(14,2) [not null, default: 0]
  payment_day smallint [not null, default: 5]
  collection_timing varchar(20) [not null, default: 'IN_ADVANCE']
  terms text [not null, default: '']
  signed_at timestamptz
  approved_by bigint
  origin varchar(20) [not null, default: 'NATIVE']
  status varchar(20) [not null, default: 'DRAFT']
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (contract_id, version_no) [name: 'contract_terms_contract_id_version_no_key', unique, type: btree]
  }

  checks {
    `(lease_end > effective_from)` [name: 'contract_terms_check']
    `(((status)::text <> 'APPROVED'::text) OR ((origin)::text = 'LEGACY_V10'::text) OR ((signed_at IS NOT NULL) AND (approved_by IS NOT NULL)))` [name: 'contract_terms_check1']
    `((collection_timing)::text = ANY ((ARRAY['IN_ADVANCE'::character varying, 'IN_ARREARS'::character varying])::text[]))` [name: 'contract_terms_collection_timing_check']
    `(deposit_required >= (0)::numeric)` [name: 'contract_terms_deposit_required_check']
    `((origin)::text = ANY ((ARRAY['NATIVE'::character varying, 'LEGACY_V10'::character varying])::text[]))` [name: 'contract_terms_origin_check']
    `((payment_day >= 1) AND (payment_day <= 31))` [name: 'contract_terms_payment_day_check']
    `(rental_price >= (0)::numeric)` [name: 'contract_terms_rental_price_check']
    `((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'APPROVED'::character varying])::text[]))` [name: 'contract_terms_status_check']
    `(version_no > 0)` [name: 'contract_terms_version_no_check']
  }

  Note: 'PostgreSQL: CREATE UNIQUE INDEX uq_approved_terms_effective ON public.contract_terms USING btree (contract_id, effective_from) WHERE ((status)::text = \'APPROVED\'::text)'
}

Table room_possessions [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  taken_at timestamptz [not null]
  returned_at timestamptz
  recorded_by bigint
  note text

  checks {
    `((returned_at IS NULL) OR (returned_at > taken_at))` [name: 'room_possessions_check']
  }

  Note: 'PostgreSQL: CREATE INDEX room_possessions_contract_id_tstzrange_excl ON public.room_possessions USING gist (contract_id, tstzrange(taken_at, returned_at, \'[)\'::text))'
}

Table move_out_notices [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  supersedes_notice_id bigint
  requested_date date [not null]
  reason text [not null, default: '']
  status varchar(20) [not null, default: 'SUBMITTED']
  submitted_by bigint [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((supersedes_notice_id IS NULL) OR (supersedes_notice_id <> id))` [name: 'move_out_notices_check']
    `((status)::text = ANY ((ARRAY['SUBMITTED'::character varying, 'APPROVED'::character varying, 'CANCELLED'::character varying, 'SUPERSEDED'::character varying])::text[]))` [name: 'move_out_notices_status_check']
  }
}

Table handovers [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  possession_id bigint
  handover_code varchar(60) [not null, unique]
  handover_type varchar(20) [not null]
  occurred_at timestamptz [not null]
  status varchar(20) [not null, default: 'DRAFT']
  given_by bigint
  received_by_tenant_id bigint
  confirmed_by bigint
  confirmed_at timestamptz
  note text

  checks {
    `(((status)::text <> 'CONFIRMED'::text) OR ((confirmed_at IS NOT NULL) AND (confirmed_by IS NOT NULL)))` [name: 'handovers_check']
    `((handover_type)::text = ANY ((ARRAY['MOVE_IN'::character varying, 'MOVE_OUT'::character varying, 'RESPONSIBILITY'::character varying])::text[]))` [name: 'handovers_handover_type_check']
    `((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'CONFIRMED'::character varying, 'UNCONFIRMED'::character varying])::text[]))` [name: 'handovers_status_check']
  }
}

Table handover_items [headercolor: #315775] {
  id bigint [pk, not null, increment]
  handover_id bigint [not null]
  asset_placement_id bigint
  line_no integer [not null]
  item_name_snapshot varchar(150) [not null]
  quantity numeric(12,2) [not null]
  condition_note text [not null]
  note text

  indexes {
    (handover_id, line_no) [name: 'handover_items_handover_id_line_no_key', unique, type: btree]
  }

  checks {
    `(line_no > 0)` [name: 'handover_items_line_no_check']
    `(quantity >= (0)::numeric)` [name: 'handover_items_quantity_check']
  }
}

Table contract_violations [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  violation_type varchar(50) [not null]
  description text [not null]
  occurred_on date [not null]
  status varchar(20) [not null, default: 'OPEN']
  resolution_note text
  created_by bigint [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((status)::text = ANY ((ARRAY['OPEN'::character varying, 'HANDLING'::character varying, 'RESOLVED'::character varying, 'DISMISSED'::character varying])::text[]))` [name: 'contract_violations_status_check']
  }
}

Table checkout_records [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  return_handover_id bigint
  billing_end date [not null]
  status varchar(20) [not null, default: 'DRAFT']
  deposit_snapshot numeric(14,2) [not null, default: 0]
  advance_snapshot numeric(14,2) [not null, default: 0]
  outstanding_snapshot numeric(14,2) [not null, default: 0]
  approved_by bigint
  approved_at timestamptz
  notes text

  checks {
    `(advance_snapshot >= (0)::numeric)` [name: 'checkout_records_advance_snapshot_check']
    `(((status)::text <> 'APPROVED'::text) OR ((approved_by IS NOT NULL) AND (approved_at IS NOT NULL)))` [name: 'checkout_records_check']
    `(deposit_snapshot >= (0)::numeric)` [name: 'checkout_records_deposit_snapshot_check']
    `(outstanding_snapshot >= (0)::numeric)` [name: 'checkout_records_outstanding_snapshot_check']
    `((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'APPROVED'::character varying, 'LEGACY_RECORDED'::character varying])::text[]))` [name: 'checkout_records_status_check']
  }

  Note: 'PostgreSQL: CREATE UNIQUE INDEX uq_approved_checkout ON public.checkout_records USING btree (contract_id) WHERE ((status)::text = \'APPROVED\'::text)'
}

Table service_items [headercolor: #315775] {
  id bigint [pk, not null, increment]
  service_code varchar(30) [not null, unique]
  name varchar(100) [not null]
  unit_name varchar(30) [not null]
  calculation_type varchar(20) [not null]
  is_mandatory boolean [not null, default: false]
  is_active boolean [not null, default: true]

  checks {
    `((calculation_type)::text = ANY ((ARRAY['METER_BASED'::character varying, 'PER_ROOM'::character varying, 'PER_PERSON'::character varying, 'PER_UNIT'::character varying, 'ONE_TIME'::character varying])::text[]))` [name: 'service_items_calculation_type_check']
  }
}

Table service_price_configs [headercolor: #315775] {
  id bigint [pk, not null, increment]
  property_id bigint [not null]
  service_item_id bigint [not null]
  effective_from date [not null]
  unit_price numeric(14,2) [not null]
  recorded_by bigint
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (property_id, service_item_id, effective_from) [name: 'service_price_configs_property_id_service_item_id_effective_key', unique, type: btree]
  }

  checks {
    `(unit_price >= (0)::numeric)` [name: 'service_price_configs_unit_price_check']
  }
}

Table contract_service_subscriptions [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  service_item_id bigint [not null]
  effective_from date [not null]
  effective_to date
  quantity integer [not null, default: 1]
  charge_mode varchar(20) [not null, default: 'PRORATED']
  recorded_by bigint

  checks {
    `((charge_mode)::text = ANY ((ARRAY['PRORATED'::character varying, 'FULL_PERIOD'::character varying, 'ONE_TIME'::character varying])::text[]))` [name: 'contract_service_subscriptions_charge_mode_check']
    `((effective_to IS NULL) OR (effective_to > effective_from))` [name: 'contract_service_subscriptions_check']
    `(quantity > 0)` [name: 'contract_service_subscriptions_quantity_check']
  }

  Note: 'PostgreSQL: CREATE INDEX contract_service_subscription_contract_id_service_item_id__excl ON public.contract_service_subscriptions USING gist (contract_id, service_item_id, daterange(effective_from, effective_to, \'[)\'::text))'
}

Table meters [headercolor: #315775] {
  id bigint [pk, not null, increment]
  room_id bigint [not null]
  service_item_id bigint [not null]
  meter_code varchar(60) [not null, unique]
  installed_at timestamptz [not null]
  retired_at timestamptz
  recorded_by bigint

  checks {
    `((retired_at IS NULL) OR (retired_at > installed_at))` [name: 'meters_check']
  }

  Note: 'PostgreSQL: CREATE INDEX meters_room_id_service_item_id_tstzrange_excl ON public.meters USING gist (room_id, service_item_id, tstzrange(installed_at, retired_at, \'[)\'::text))'
}

Table meter_readings [headercolor: #315775] {
  id bigint [pk, not null, increment]
  correction_item_id bigint [unique]
  meter_id bigint [not null]
  observed_at timestamptz [not null]
  reading_value numeric(14,3) [not null]
  time_precision varchar(30) [not null, default: 'EXACT']
  revision_no integer [not null, default: 1]
  supersedes_reading_id bigint [unique]
  handover_id bigint
  recorded_by bigint [not null]
  reason text
  recorded_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (meter_id, observed_at) [name: 'idx_reading_meter_time', type: btree]
    (meter_id, observed_at, revision_no) [name: 'meter_readings_meter_id_observed_at_revision_no_key', unique, type: btree]
  }

  checks {
    `((supersedes_reading_id IS NULL) OR (supersedes_reading_id <> id))` [name: 'meter_readings_check']
    `(reading_value >= (0)::numeric)` [name: 'meter_readings_reading_value_check']
    `(revision_no > 0)` [name: 'meter_readings_revision_no_check']
    `((time_precision)::text = ANY ((ARRAY['EXACT'::character varying, 'LEGACY_DAY_BOUNDARY'::character varying])::text[]))` [name: 'meter_readings_time_precision_check']
  }
}

Table consumption_segments [headercolor: #315775] {
  id bigint [pk, not null, increment]
  start_reading_id bigint [not null]
  end_reading_id bigint [not null]
  contract_id bigint
  responsibility varchar(10) [not null]
  supersedes_segment_id bigint [unique]
  recorded_by bigint
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (start_reading_id, end_reading_id) [name: 'consumption_segments_start_reading_id_end_reading_id_key', unique, type: btree]
  }

  checks {
    `(start_reading_id <> end_reading_id)` [name: 'consumption_segments_check']
    `(((responsibility)::text = 'TENANT'::text) = (contract_id IS NOT NULL))` [name: 'consumption_segments_check1']
    `((supersedes_segment_id IS NULL) OR (supersedes_segment_id <> id))` [name: 'consumption_segments_check2']
    `((responsibility)::text = ANY ((ARRAY['TENANT'::character varying, 'OWNER'::character varying])::text[]))` [name: 'consumption_segments_responsibility_check']
  }
}

Table alert_policies [headercolor: #315775] {
  id bigint [pk, not null, increment]
  service_item_id bigint [not null]
  property_id bigint
  room_id bigint
  effective_from date [not null]
  history_months smallint [not null, default: 3]
  minimum_days integer [not null, default: 7]
  threshold_percentage numeric(9,2) [not null, default: 50]
  absolute_daily_threshold numeric(14,3)

  checks {
    `(absolute_daily_threshold > (0)::numeric)` [name: 'alert_policies_absolute_daily_threshold_check']
    `(num_nonnulls(property_id, room_id) = 1)` [name: 'alert_policies_check']
    `((history_months >= 1) AND (history_months <= 12))` [name: 'alert_policies_history_months_check']
    `(minimum_days > 0)` [name: 'alert_policies_minimum_days_check']
    `(threshold_percentage > (0)::numeric)` [name: 'alert_policies_threshold_percentage_check']
  }

  Note: 'PostgreSQL: CREATE UNIQUE INDEX uq_policy_property ON public.alert_policies USING btree (property_id, service_item_id, effective_from) WHERE (property_id IS NOT NULL); CREATE UNIQUE INDEX uq_policy_room ON public.alert_policies USING btree (room_id, service_item_id, effective_from) WHERE (room_id IS NOT NULL)'
}

Table consumption_alerts [headercolor: #315775] {
  id bigint [pk, not null, increment]
  segment_id bigint [not null]
  policy_id bigint [not null]
  supersedes_alert_id bigint [unique]
  baseline_daily_average numeric(18,6)
  applied_threshold numeric(9,2) [not null]
  method varchar(40) [not null, default: 'WEIGHTED_DAILY']
  status varchar(30) [not null, default: 'PENDING']
  context_note text
  checked_by bigint
  checked_at timestamptz
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (segment_id, policy_id) [name: 'consumption_alerts_segment_id_policy_id_key', unique, type: btree]
  }

  checks {
    `((baseline_daily_average IS NULL) OR (baseline_daily_average >= (0)::numeric))` [name: 'consumption_alerts_baseline_daily_average_check']
    `(((status)::text <> ALL ((ARRAY['CONFIRMED'::character varying, 'DISMISSED'::character varying])::text[])) OR ((checked_by IS NOT NULL) AND (checked_at IS NOT NULL)))` [name: 'consumption_alerts_check']
    `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'CONFIRMED'::character varying, 'DISMISSED'::character varying, 'INSUFFICIENT_HISTORY'::character varying, 'INCOMPARABLE'::character varying])::text[]))` [name: 'consumption_alerts_status_check']
  }
}

Table alert_baseline_sources [headercolor: #315775] {
  id bigint [pk, not null, increment]
  alert_id bigint [not null]
  source_segment_id bigint [not null]

  indexes {
    (alert_id, source_segment_id) [name: 'alert_baseline_sources_alert_id_source_segment_id_key', unique, type: btree]
  }
}

Table maintenance_schedules [headercolor: #315775] {
  id bigint [pk, not null, increment]
  asset_id bigint
  room_id bigint
  property_id bigint
  title varchar(150) [not null]
  interval_days integer [not null]
  next_due date [not null]
  is_active boolean [not null, default: true]
  created_by bigint

  checks {
    `(num_nonnulls(asset_id, room_id, property_id) = 1)` [name: 'maintenance_schedules_check']
    `(interval_days > 0)` [name: 'maintenance_schedules_interval_days_check']
  }
}

Table maintenance_requests [headercolor: #315775] {
  id bigint [pk, not null, increment]
  room_id bigint
  property_id bigint
  asset_placement_id bigint
  schedule_id bigint
  scheduled_for date
  submitted_by bigint [not null]
  assigned_to bigint
  title varchar(150) [not null]
  description text [not null]
  priority varchar(20) [not null, default: 'NORMAL']
  status varchar(20) [not null, default: 'NEW']
  incident_type varchar(50) [not null, default: 'GENERAL']
  expected_date date [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (schedule_id, scheduled_for) [name: 'maintenance_requests_schedule_id_scheduled_for_key', unique, type: btree]
  }

  checks {
    `(num_nonnulls(room_id, property_id, asset_placement_id) = 1)` [name: 'maintenance_requests_check']
    `((schedule_id IS NULL) = (scheduled_for IS NULL))` [name: 'maintenance_requests_check1']
    `((priority)::text = ANY ((ARRAY['URGENT'::character varying, 'NORMAL'::character varying, 'LOW'::character varying])::text[]))` [name: 'maintenance_requests_priority_check']
    `((status)::text = ANY ((ARRAY['NEW'::character varying, 'ACCEPTED'::character varying, 'IN_PROGRESS'::character varying, 'COMPLETED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'maintenance_requests_status_check']
  }
}

Table maintenance_events [headercolor: #315775] {
  id bigint [pk, not null, increment]
  request_id bigint [not null]
  action varchar(30) [not null]
  actor_id bigint [not null]
  note text [not null, default: '']
  recorded_at timestamptz [not null, default: `clock_timestamp()`]
}

Table maintenance_costs [headercolor: #315775] {
  id bigint [pk, not null, increment]
  request_id bigint [not null]
  description text [not null]
  amount numeric(14,2) [not null]
  incurred_on date [not null]
  advanced_by_tenant_id bigint
  recorded_by bigint [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `(amount >= (0)::numeric)` [name: 'maintenance_costs_amount_check']
  }
}

Table billing_documents [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint
  reservation_id bigint
  checkout_id bigint
  related_document_id bigint
  document_code varchar(80) [not null, unique]
  document_type varchar(30) [not null]
  billing_period date
  issue_date date [not null]
  due_date date [not null]
  status varchar(20) [not null, default: 'DRAFT']
  reason text [not null, default: '']
  created_by bigint
  issued_by bigint
  issued_at timestamptz
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((billing_period IS NULL) OR (EXTRACT(day FROM billing_period) = (1)::numeric))` [name: 'billing_documents_billing_period_check']
    `(num_nonnulls(contract_id, reservation_id) = 1)` [name: 'billing_documents_check']
    `(due_date >= issue_date)` [name: 'billing_documents_check1']
    `(((document_type)::text <> 'MONTHLY'::text) OR ((contract_id IS NOT NULL) AND (billing_period IS NOT NULL)))` [name: 'billing_documents_check2']
    `(((status)::text = 'ISSUED'::text) = (issued_at IS NOT NULL))` [name: 'billing_documents_check3']
    `(((document_type)::text <> 'ADJUSTMENT'::text) OR (related_document_id IS NOT NULL))` [name: 'billing_documents_check4']
    `((document_type)::text = ANY ((ARRAY['MONTHLY'::character varying, 'FINAL_CHARGE'::character varying, 'COMPENSATION'::character varying, 'ADJUSTMENT'::character varying, 'REIMBURSEMENT'::character varying, 'OPENING_CHARGE'::character varying])::text[]))` [name: 'billing_documents_document_type_check']
    `((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'ISSUED'::character varying])::text[]))` [name: 'billing_documents_status_check']
  }

  Note: 'PostgreSQL: CREATE UNIQUE INDEX uq_monthly_document ON public.billing_documents USING btree (contract_id, billing_period) WHERE ((document_type)::text = \'MONTHLY\'::text)'
}

Table billing_items [headercolor: #315775] {
  id bigint [pk, not null, increment]
  document_id bigint [not null]
  line_no integer [not null]
  item_kind varchar(30) [not null]
  direction varchar(10) [not null, default: 'DEBIT']
  adjusts_item_id bigint
  contract_term_id bigint
  subscription_id bigint
  segment_id bigint
  service_price_config_id bigint
  handover_item_id bigint
  maintenance_cost_id bigint
  violation_id bigint
  item_name_snapshot varchar(150) [not null]
  unit_name_snapshot varchar(40) [not null]
  unit_price_snapshot numeric(14,4) [not null]
  calculation_basis varchar(20) [not null]
  quantity_snapshot numeric(18,6)
  calculation_period date
  service_from date [not null]
  service_to date [not null]
  verification_status varchar(20) [not null, default: 'VERIFIED']
  basis_note text [not null, default: '']
  source_key varchar(120) [unique]

  indexes {
    (document_id, line_no) [name: 'billing_items_document_id_line_no_key', unique, type: btree]
  }

  checks {
    `((calculation_basis)::text = ANY ((ARRAY['METER'::character varying, 'PRORATED'::character varying, 'FULL_PERIOD'::character varying, 'FIXED'::character varying, 'ESTIMATED'::character varying])::text[]))` [name: 'billing_items_calculation_basis_check']
    `(service_to > service_from)` [name: 'billing_items_check']
    `((adjusts_item_id IS NULL) OR (adjusts_item_id <> id))` [name: 'billing_items_check1']
    `((((calculation_basis)::text = 'METER'::text) AND (segment_id IS NOT NULL) AND (quantity_snapshot IS NULL)) OR (((calculation_basis)::text <> 'METER'::text) AND (quantity_snapshot IS NOT NULL) AND (quantity_snapshot > (0)::numeric)))` [name: 'billing_items_check2']
    `(((calculation_basis)::text <> 'PRORATED'::text) OR ((calculation_period IS NOT NULL) AND (EXTRACT(day FROM calculation_period) = (1)::numeric)))` [name: 'billing_items_check3']
    `(((calculation_basis)::text <> 'ESTIMATED'::text) OR (((verification_status)::text = 'ESTIMATED'::text) AND (btrim(basis_note) <> ''::text)))` [name: 'billing_items_check4']
    `((direction)::text = ANY ((ARRAY['DEBIT'::character varying, 'CREDIT'::character varying])::text[]))` [name: 'billing_items_direction_check']
    `((item_kind)::text = ANY ((ARRAY['ROOM_RENT'::character varying, 'UTILITY'::character varying, 'SERVICE'::character varying, 'DAMAGE'::character varying, 'DISCOUNT'::character varying, 'REIMBURSEMENT'::character varying, 'OTHER'::character varying])::text[]))` [name: 'billing_items_item_kind_check']
    `(line_no > 0)` [name: 'billing_items_line_no_check']
    `(unit_price_snapshot >= (0)::numeric)` [name: 'billing_items_unit_price_snapshot_check']
    `((verification_status)::text = ANY ((ARRAY['VERIFIED'::character varying, 'ESTIMATED'::character varying, 'DISPUTED'::character varying, 'PENDING'::character varying])::text[]))` [name: 'billing_items_verification_status_check']
  }

  Note: 'PostgreSQL: CREATE UNIQUE INDEX uq_original_measured_charge ON public.billing_items USING btree (segment_id) WHERE ((segment_id IS NOT NULL) AND (adjusts_item_id IS NULL))'
}

Table cash_accounts [headercolor: #315775] {
  id bigint [pk, not null, increment]
  property_id bigint
  account_code varchar(60) [not null, unique]
  name varchar(150) [not null]
  account_type varchar(20) [not null]
  is_active boolean [not null, default: true]

  checks {
    `((account_type)::text = ANY ((ARRAY['CASH'::character varying, 'BANK'::character varying])::text[]))` [name: 'cash_accounts_account_type_check']
  }
}

Table cash_transactions [headercolor: #315775] {
  id bigint [pk, not null, increment]
  payment_document_id bigint
  cash_account_id bigint [not null]
  payer_or_payee_id bigint
  transaction_code varchar(80) [not null, unique]
  direction varchar(5) [not null]
  amount numeric(14,2) [not null]
  method varchar(30) [not null]
  occurred_at timestamptz [not null]
  recorded_at timestamptz [not null, default: `clock_timestamp()`]
  status varchar(20) [not null, default: 'PENDING']
  external_reference varchar(150)
  counterparty_note text
  reason text
  recorded_by bigint [not null]
  confirmed_by bigint
  confirmed_at timestamptz

  indexes {
    occurred_at [name: 'idx_cash_occurred', type: btree]
  }

  checks {
    `(amount > (0)::numeric)` [name: 'cash_transactions_amount_check']
    `(((status)::text <> 'CONFIRMED'::text) OR ((confirmed_by IS NOT NULL) AND (confirmed_at IS NOT NULL)))` [name: 'cash_transactions_check']
    `((direction)::text = ANY ((ARRAY['IN'::character varying, 'OUT'::character varying])::text[]))` [name: 'cash_transactions_direction_check']
    `((method)::text = ANY ((ARRAY['CASH'::character varying, 'BANK_TRANSFER_MANUAL'::character varying, 'OTHER'::character varying])::text[]))` [name: 'cash_transactions_method_check']
    `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'CONFIRMED'::character varying, 'VOID'::character varying])::text[]))` [name: 'cash_transactions_status_check']
  }

  Note: 'PostgreSQL: CREATE INDEX idx_cash_payment_document ON public.cash_transactions USING btree (payment_document_id) WHERE (payment_document_id IS NOT NULL); CREATE UNIQUE INDEX uq_external_cash ON public.cash_transactions USING btree (cash_account_id, external_reference) WHERE ((external_reference IS NOT NULL) AND ((status)::text = \'CONFIRMED\'::text))'
}

Table fund_accounts [headercolor: #315775] {
  id bigint [pk, not null, increment]
  fund_code varchar(100) [not null, unique]
  fund_type varchar(20) [not null]
  reconciliation_status varchar(20) [not null, default: 'VERIFIED']
  contract_id bigint
  reservation_id bigint
  unapplied_receipt_id bigint [unique]
  beneficiary_tenant_id bigint
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((((fund_type)::text = ANY ((ARRAY['DEPOSIT'::character varying, 'ADVANCE'::character varying])::text[])) AND (contract_id IS NOT NULL) AND (reservation_id IS NULL) AND (unapplied_receipt_id IS NULL) AND (beneficiary_tenant_id IS NOT NULL)) OR (((fund_type)::text = 'RESERVATION'::text) AND (reservation_id IS NOT NULL) AND (contract_id IS NULL) AND (unapplied_receipt_id IS NULL)) OR (((fund_type)::text = 'UNAPPLIED'::text) AND (unapplied_receipt_id IS NOT NULL) AND (contract_id IS NULL) AND (reservation_id IS NULL)))` [name: 'fund_accounts_check']
    `((fund_type)::text = ANY ((ARRAY['DEPOSIT'::character varying, 'ADVANCE'::character varying, 'RESERVATION'::character varying, 'UNAPPLIED'::character varying])::text[]))` [name: 'fund_accounts_fund_type_check']
    `((reconciliation_status)::text = ANY ((ARRAY['VERIFIED'::character varying, 'PENDING'::character varying])::text[]))` [name: 'fund_accounts_reconciliation_status_check']
  }

  Note: 'PostgreSQL: CREATE UNIQUE INDEX uq_contract_fund ON public.fund_accounts USING btree (contract_id, fund_type) WHERE (contract_id IS NOT NULL); CREATE UNIQUE INDEX uq_reservation_fund ON public.fund_accounts USING btree (reservation_id) WHERE (reservation_id IS NOT NULL)'
}

Table fund_entries [headercolor: #315775] {
  id bigint [pk, not null, increment]
  entry_code varchar(120) [not null, unique]
  entry_type varchar(30) [not null]
  cash_transaction_id bigint
  from_fund_id bigint
  to_fund_id bigint
  debit_item_id bigint
  credit_item_id bigint
  original_entry_id bigint
  amount numeric(14,2) [not null]
  reason text [not null, default: '']
  posted_by bigint [not null]
  posted_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    debit_item_id [name: 'idx_entry_debit', type: btree]
    from_fund_id [name: 'idx_entry_from', type: btree]
    to_fund_id [name: 'idx_entry_to', type: btree]
  }

  checks {
    `(amount > (0)::numeric)` [name: 'fund_entries_amount_check']
    `((from_fund_id IS NULL) OR (to_fund_id IS NULL) OR (from_fund_id <> to_fund_id))` [name: 'fund_entries_check']
    `((original_entry_id IS NULL) OR (original_entry_id <> id))` [name: 'fund_entries_check1']
    `((((entry_type)::text = 'RECEIVE'::text) AND (cash_transaction_id IS NOT NULL) AND (to_fund_id IS NOT NULL) AND (num_nonnulls(from_fund_id, debit_item_id, credit_item_id, original_entry_id) = 0)) OR (((entry_type)::text = 'PAYMENT'::text) AND (from_fund_id IS NOT NULL) AND (debit_item_id IS NOT NULL) AND (num_nonnulls(cash_transaction_id, to_fund_id, credit_item_id, original_entry_id) = 0)) OR (((entry_type)::text = 'TRANSFER'::text) AND (from_fund_id IS NOT NULL) AND (to_fund_id IS NOT NULL) AND (num_nonnulls(cash_transaction_id, debit_item_id, credit_item_id, original_entry_id) = 0)) OR (((entry_type)::text = 'REFUND'::text) AND (from_fund_id IS NOT NULL) AND (cash_transaction_id IS NOT NULL) AND (num_nonnulls(to_fund_id, debit_item_id, credit_item_id, original_entry_id) = 0)) OR (((entry_type)::text = 'CREDIT_TO_FUND'::text) AND (credit_item_id IS NOT NULL) AND (to_fund_id IS NOT NULL) AND (num_nonnulls(cash_transaction_id, from_fund_id, debit_item_id, original_entry_id) = 0)) OR (((entry_type)::text = 'ADJUSTMENT_RELEASE'::text) AND (credit_item_id IS NOT NULL) AND (original_entry_id IS NOT NULL) AND (to_fund_id IS NOT NULL) AND (num_nonnulls(cash_transaction_id, from_fund_id, debit_item_id) = 0)) OR (((entry_type)::text = 'REVERSAL'::text) AND (original_entry_id IS NOT NULL) AND (num_nonnulls(cash_transaction_id, from_fund_id, to_fund_id, debit_item_id, credit_item_id) = 0)) OR (((entry_type)::text = 'OPENING_BALANCE'::text) AND (to_fund_id IS NOT NULL) AND (btrim(reason) <> ''::text) AND (num_nonnulls(cash_transaction_id, from_fund_id, debit_item_id, credit_item_id, original_entry_id) = 0)))` [name: 'fund_entries_check2']
    `((entry_type)::text = ANY ((ARRAY['RECEIVE'::character varying, 'PAYMENT'::character varying, 'TRANSFER'::character varying, 'REFUND'::character varying, 'CREDIT_TO_FUND'::character varying, 'ADJUSTMENT_RELEASE'::character varying, 'REVERSAL'::character varying, 'OPENING_BALANCE'::character varying])::text[]))` [name: 'fund_entries_entry_type_check']
  }
}

Table fund_holds [headercolor: #315775] {
  id bigint [pk, not null, increment]
  fund_account_id bigint [not null]
  related_billing_item_id bigint
  amount numeric(14,2) [not null]
  reason text [not null]
  review_on date [not null]
  created_by bigint [not null]
  released_at timestamptz
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `(amount > (0)::numeric)` [name: 'fund_holds_amount_check']
    `(btrim(reason) <> ''::text)` [name: 'fund_holds_reason_check']
  }
}

Table notifications [headercolor: #315775] {
  id bigint [pk, not null, increment]
  notification_type varchar(40) [not null]
  title varchar(200) [not null]
  body text [not null]
  billing_document_id bigint
  contract_id bigint
  maintenance_request_id bigint
  consumption_alert_id bigint
  deduplication_key varchar(180) [not null, unique]
  created_by bigint
  sent_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `(num_nonnulls(billing_document_id, contract_id, maintenance_request_id, consumption_alert_id) <= 1)` [name: 'notifications_check']
  }
}

Table notification_recipients [headercolor: #315775] {
  id bigint [pk, not null, increment]
  notification_id bigint [not null]
  user_id bigint [not null]
  read_at timestamptz

  indexes {
    (notification_id, user_id) [name: 'notification_recipients_notification_id_user_id_key', unique, type: btree]
  }
}

Table stored_files [headercolor: #315775] {
  id bigint [pk, not null, increment]
  storage_key varchar(255) [not null, unique]
  original_name varchar(255) [not null]
  content_type varchar(100) [not null]
  size_bytes bigint
  sha256 varchar(64)
  external_url text
  uploaded_by bigint [not null]
  uploaded_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `((external_url IS NOT NULL) OR ((sha256 IS NOT NULL) AND (size_bytes IS NOT NULL)))` [name: 'stored_files_check']
    `(size_bytes > 0)` [name: 'stored_files_size_bytes_check']
  }
}

Table file_attachments [headercolor: #315775] {
  id bigint [pk, not null, increment]
  file_id bigint [not null]
  room_id bigint
  asset_id bigint
  handover_item_id bigint
  meter_reading_id bigint
  maintenance_request_id bigint
  maintenance_cost_id bigint
  contract_term_id bigint
  billing_document_id bigint
  violation_id bigint
  fund_entry_id bigint
  caption text [not null, default: '']
  sort_order integer [not null, default: 0]
  attached_by bigint [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]

  checks {
    `(num_nonnulls(room_id, asset_id, handover_item_id, meter_reading_id, maintenance_request_id, maintenance_cost_id, contract_term_id, billing_document_id, violation_id, fund_entry_id) = 1)` [name: 'file_attachments_check']
  }
}

