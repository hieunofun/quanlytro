users:id -> meter_readings:recorded_by [dir=both, arrowtail=tee, arrowhead=crow];
service_items:id -> meter_readings:service_item_id [dir=both, arrowtail=tee, arrowhead=crow];
invoices:id -> payment_transactions:invoice_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> payment_transactions:received_by [dir=both, arrowtail=tee, arrowhead=crow];
