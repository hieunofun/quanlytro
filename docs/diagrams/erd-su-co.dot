digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="1.05", splines=polyline, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#6B7280", arrowsize=0.6];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>users</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
properties [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>properties</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
rooms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>rooms</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR></TABLE>>];
assets [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>assets</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="asset_type_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK asset_type_id</FONT></TD></TR><TR><TD PORT="quantity" ALIGN="LEFT"><FONT POINT-SIZE="12">quantity</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
asset_placements [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>asset_placements</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="asset_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK asset_id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
maintenance_requests [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>maintenance_requests</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR><TR><TD PORT="asset_placement_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK asset_placement_id</FONT></TD></TR><TR><TD PORT="schedule_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK schedule_id</FONT></TD></TR><TR><TD PORT="submitted_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK submitted_by</FONT></TD></TR><TR><TD PORT="assigned_to" ALIGN="LEFT"><FONT POINT-SIZE="12">FK assigned_to</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
maintenance_events [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>maintenance_events</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="request_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK request_id</FONT></TD></TR><TR><TD PORT="actor_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK actor_id</FONT></TD></TR></TABLE>>];
maintenance_costs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>maintenance_costs</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="request_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK request_id</FONT></TD></TR><TR><TD PORT="amount" ALIGN="LEFT"><FONT POINT-SIZE="12">amount</FONT></TD></TR><TR><TD PORT="advanced_by_tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK advanced_by_tenant_id</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR></TABLE>>];
maintenance_schedules [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>maintenance_schedules</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="asset_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK asset_id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR><TR><TD PORT="created_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK created_by</FONT></TD></TR></TABLE>>];
stored_files [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>stored_files</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="uploaded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK uploaded_by</FONT></TD></TR></TABLE>>];
file_attachments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>file_attachments</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="file_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK file_id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="asset_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK asset_id</FONT></TD></TR><TR><TD PORT="handover_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK handover_item_id</FONT></TD></TR><TR><TD PORT="meter_reading_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK meter_reading_id</FONT></TD></TR><TR><TD PORT="maintenance_request_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK maintenance_request_id</FONT></TD></TR><TR><TD PORT="maintenance_cost_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK maintenance_cost_id</FONT></TD></TR><TR><TD PORT="contract_term_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_term_id</FONT></TD></TR><TR><TD PORT="billing_document_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK billing_document_id</FONT></TD></TR><TR><TD PORT="violation_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK violation_id</FONT></TD></TR><TR><TD PORT="fund_entry_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK fund_entry_id</FONT></TD></TR><TR><TD PORT="attached_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK attached_by</FONT></TD></TR></TABLE>>];
assets:id -> asset_placements:asset_id [dir=both, arrowtail=tee, arrowhead=crow];
properties:id -> asset_placements:property_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> asset_placements:recorded_by [dir=both, arrowtail=tee, arrowhead=crow];
rooms:id -> asset_placements:room_id [dir=both, arrowtail=tee, arrowhead=crow];
assets:id -> file_attachments:asset_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> file_attachments:attached_by [dir=both, arrowtail=tee, arrowhead=crow];
stored_files:id -> file_attachments:file_id [dir=both, arrowtail=tee, arrowhead=crow];
maintenance_costs:id -> file_attachments:maintenance_cost_id [dir=both, arrowtail=tee, arrowhead=crow];
maintenance_requests:id -> file_attachments:maintenance_request_id [dir=both, arrowtail=tee, arrowhead=crow];
rooms:id -> file_attachments:room_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> maintenance_costs:recorded_by [dir=both, arrowtail=tee, arrowhead=crow];
maintenance_requests:id -> maintenance_costs:request_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> maintenance_events:actor_id [dir=both, arrowtail=tee, arrowhead=crow];
maintenance_requests:id -> maintenance_events:request_id [dir=both, arrowtail=tee, arrowhead=crow];
asset_placements:id -> maintenance_requests:asset_placement_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> maintenance_requests:assigned_to [dir=both, arrowtail=tee, arrowhead=crow];
properties:id -> maintenance_requests:property_id [dir=both, arrowtail=tee, arrowhead=crow];
rooms:id -> maintenance_requests:room_id [dir=both, arrowtail=tee, arrowhead=crow];
maintenance_schedules:id -> maintenance_requests:schedule_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> maintenance_requests:submitted_by [dir=both, arrowtail=tee, arrowhead=crow];
assets:id -> maintenance_schedules:asset_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> maintenance_schedules:created_by [dir=both, arrowtail=tee, arrowhead=crow];
properties:id -> maintenance_schedules:property_id [dir=both, arrowtail=tee, arrowhead=crow];
rooms:id -> maintenance_schedules:room_id [dir=both, arrowtail=tee, arrowhead=crow];
properties:id -> rooms:property_id [dir=both, arrowtail=tee, arrowhead=crow];
users:id -> stored_files:uploaded_by [dir=both, arrowtail=tee, arrowhead=crow];
}
