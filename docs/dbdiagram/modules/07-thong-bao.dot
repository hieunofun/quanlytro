digraph module {
graph [rankdir=LR,bgcolor="transparent",pad="0.30",nodesep="0.45",ranksep="0.85",splines=spline,outputorder=edgesfirst,fontname="Arial",newrank=true];
node [shape=plain,fontname="Arial"];
edge [fontname="Arial",fontsize=10,arrowsize=0.65,penwidth=1.0];
"notifications" [id="table-notifications",tooltip="Sự kiện thông báo có nguồn và khóa chống lặp",label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="4" PORT="header" ALIGN="LEFT" BGCOLOR="#BE185D"><FONT FACE="Arial" COLOR="#FFFFFF" POINT-SIZE="17"><B>notifications</B></FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#EFF6FF"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="11">Đầy đủ 11 cột</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">PK</FONT></TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033"><B>id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">&#160;</FONT></TD><TD PORT="notification_type" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">notification_type</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">varchar(40)</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">&#160;</FONT></TD><TD PORT="title" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">title</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">varchar(200)</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">&#160;</FONT></TD><TD PORT="body" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">body</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">text</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">FK</FONT></TD><TD PORT="billing_document_id" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">billing_document_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NULL</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">FK</FONT></TD><TD PORT="contract_id" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">contract_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NULL</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">FK</FONT></TD><TD PORT="maintenance_request_id" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">maintenance_request_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NULL</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">FK</FONT></TD><TD PORT="consumption_alert_id" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">consumption_alert_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NULL</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">UQ</FONT></TD><TD PORT="deduplication_key" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">deduplication_key</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">varchar(180)</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">FK</FONT></TD><TD PORT="created_by" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">created_by</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NULL</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">&#160;</FONT></TD><TD PORT="sent_at" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">sent_at</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">timestamptz</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR></TABLE>>];
"notification_recipients" [id="table-notification_recipients",tooltip="Trạng thái đọc riêng từng tài khoản",label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="4" PORT="header" ALIGN="LEFT" BGCOLOR="#BE185D"><FONT FACE="Arial" COLOR="#FFFFFF" POINT-SIZE="17"><B>notification_recipients</B></FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#EFF6FF"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="11">Đầy đủ 4 cột</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">PK</FONT></TD><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033"><B>id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">FK</FONT></TD><TD PORT="notification_id" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">notification_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">FK</FONT></TD><TD PORT="user_id" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#172033">user_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#475569">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#64748B">NN</FONT></TD></TR><TR><TD WIDTH="45" ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT FACE="Arial" POINT-SIZE="10" COLOR="#475569">&#160;</FONT></TD><TD PORT="read_at" ALIGN="LEFT" BGCOLOR="#F