// 04 · Dịch vụ và điện nước — một phần của model49 / V13.
// Bảng chính giữ đủ cột; bảng ngoài nhóm chỉ là THAM CHIẾU RÚT GỌN.
// Chỉ gồm FK có bảng nguồn thuộc nhóm. Không mở rộng đệ quy từ bảng tham chiếu.
// Không dùng file từng phần để tạo lại database.
Project DienNuoc {
  database_type: 'PostgreSQL'
  Note: 'Dịch vụ và điện nước: 9 bảng chính đầy đủ và 6 bảng tham chiếu rút gọn. 28 FK thật có bảng nguồn thuộc nhóm. Bảng xám chỉ hiện PK/cột đích FK và một mã/tên có thật để nhận diện; không phải toàn bộ định nghĩa bảng. Bản chuẩn đầy đủ: docs/quanlytro.dbml.'
}

Table service_items [headercolor: #0284C7] {
  id bigint [pk, not null, increment]
  service_code varchar(30) [not null, unique]
  name varchar(100) [not null]
  unit_name varchar(30) [not null]
  calculation_type varchar(20) [not null]
  is_mandatory boolean [not null, default: false]
  is_active boolean [not null, default: true]

  checks {
    `((calculation_type)::text = ANY ((ARRAY['METER_BASED'::character varying, 'PER_ROOM'::character varying, 'PER_PERSON'::character varying, 'PER_UNIT'::character varying, 'ONE_TIME'::character varying])::text[]))` [name: 'service_items_calculation_type_check']
  }

  Note: 'Danh mục dịch vụ; không thay đăng ký dịch vụ'
}

Table service_price_configs [headercolor: #0284C7] {
  id bigint [pk, not null, increment]
  property_id bigint [not null]
  service_item_id bigint [not null]
  effective_from date [not null]
  unit_price numeric(14,2) [not null]
  recorded_by bigint
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (property_id, service_item_id, effective_from) [name: 'service_price_configs_property_id_service_item_id_effective_key', unique, type: btree]
  }

  checks {
    `(unit_price >= (0)::numeric)` [name: 'service_price_configs_unit_price_check']
  }

  Note: 'Lịch sử giá dịch vụ tại khu'
}

Table contract_service_subscriptions [headercolor: #0284C7] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  service_item_id bigint [not null]
  effective_from date [not null]
  effective_to date
  quantity integer [not null, default: 1]
  charge_mode varchar(20) [not null, default: 'PRORATED']
  recorded_by bigint

  checks {
    `((charge_mode)::text = ANY ((ARRAY['PRORATED'::character varying, 'FULL_PERIOD'::character varying, 'ONE_TIME'::character varying])::text[]))` [name: 'contract_service_subscriptions_charge_mode_check']
    `((effective_to IS NULL) OR (effective_to > effective_from))` [name: 'contract_service_subscriptions_check']
    `(quantity > 0)` [name: 'contract_service_subscriptions_quantity_check']
  }

  Note: 'Đăng ký và số lượng theo khoảng, chế độ cả kỳ/chia ngày\n\nCREATE INDEX contract_service_subscription_contract_id_service_item_id__excl ON public.contract_service_subscriptions USING gist (contract_id, service_item_id, daterange(effective_from, effective_to, \'[)\'::text))\n\ncontract_service_subscription_contract_id_service_item_id__excl: EXCLUDE USING gist (contract_id WITH =, service_item_id WITH =, daterange(effective_from, effective_to, \'[)\'::text) WITH &&)'
}

Table meters [headercolor: #0284C7] {
  id bigint [pk, not null, increment]
  room_id bigint [not null]
  service_item_id bigint [not null]
  meter_code varchar(60) [not null, unique]
  installed_at timestamptz [not null]
  retired_at timestamptz
  recorded_by bigint

  checks {
    `((retired_at IS NULL) OR (retired_at > installed_at))` [name: 'meters_check']
  }

  Note: 'Công tơ vật lý; thay tạo mã mới\n\nCREATE INDEX meters_room_id_service_item_id_tstzrange_excl ON public.meters USING gist (room_id, service_item_id, tstzrange(installed_at, retired_at, \'[)\'::text))\n\nmeters_room_id_service_item_id_tstzrange_excl: EXCLUDE USING gist (room_id WITH =, service_item_id WITH =, tstzrange(installed_at, retired_at, \'[)\'::text) WITH &&)'
}

Table meter_readings [headercolor: #0284C7] {
  id bigint [pk, not null, increment]
  meter_id bigint [not null]
  observed_at timestamptz [not null]
  reading_value numeric(14,3) [not null]
  time_precision varchar(30) [not null, default: 'EXACT']
  revision_no integer [not null, default: 1]
  supersedes_reading_id bigint [unique]
  handover_id bigint
  recorded_by bigint [not null]
  reason text
  recorded_at timestamptz [not null, default: `clock_timestamp()`]
  correction_item_id bigint [unique]

  indexes {
    (meter_id, observed_at) [name: 'idx_reading_meter_time', type: btree]
    (meter_id, observed_at, revision_no) [name: 'meter_readings_meter_id_observed_at_revision_no_key', unique, type: btree]
  }

  checks {
    `((supersedes_reading_id IS NULL) OR (supersedes_reading_id <> id))` [name: 'meter_readings_check']
    `(reading_value >= (0)::numeric)` [name: 'meter_readings_reading_value_check']
    `(revision_no > 0)` [name: 'meter_readings_revision_no_check']
    `((time_precision)::text = ANY ((ARRAY['EXACT'::character varying, 'LEGACY_DAY_BOUNDARY'::character varying])::text[]))` [name: 'meter_readings_time_precision_check']
  }

  Note: 'Điểm đo thực và chuỗi phiên bản sửa'
}

Table consumption_segments [headercolor: #0284C7] {
  id bigint [pk, not null, increment]
  start_reading_id bigint [not null]
  end_reading_id bigint [not null]
  contract_id bigint
  responsibility varchar(10) [not null]
  supersedes_segment_id bigint [unique]
  recorded_by bigint
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (start_reading_id, end_reading_id) [name: 'consumption_segments_start_reading_id_end_reading_id_key', unique, type: btree]
  }

  checks {
    `(start_reading_id <> end_reading_id)` [name: 'consumption_segments_check']
    `(((responsibility)::text = 'TENANT'::text) = (contract_id IS NOT NULL))` [name: 'consumption_segments_check1']
    `((supersedes_segment_id IS NULL) OR (supersedes_segment_id <> id))` [name: 'consumption_segments_check2']
    `((responsibility)::text = ANY ((ARRAY['TENANT'::character varying, 'OWNER'::character varying])::text[]))` [name: 'consumption_segments_responsibility_check']
  }

  Note: 'Khoảng đo giao trách nhiệm cho hợp đồng hoặc chủ nhà'
}

Table alert_policies [headercolor: #0284C7] {
  id bigint [pk, not null, increment]
  service_item_id bigint [not null]
  property_id bigint
  room_id bigint
  effective_from date [not null]
  history_months smallint [not null, default: 3]
  minimum_days integer [not null, default: 7]
  threshold_percentage numeric(9,2) [not null, default: 50]
  absolute_daily_threshold numeric(14,3)

  checks {
    `(absolute_daily_threshold > (0)::numeric)` [name: 'alert_policies_absolute_daily_threshold_check']
    `(num_nonnulls(property_id, room_id) = 1)` [name: 'alert_policies_check']
    `((history_months >= 1) AND (history_months <= 12))` [name: 'alert_policies_history_months_check']
    `(minimum_days > 0)` [name: 'alert_policies_minimum_days_check']
    `(threshold_percentage > (0)::numeric)` [name: 'alert_policies_threshold_percentage_check']
  }

  Note: 'Ngưỡng theo khu/phòng và dịch vụ, có hiệu lực\n\nCREATE UNIQUE INDEX uq_policy_property ON public.alert_policies USING btree (property_id, service_item_id, effective_from) WHERE (property_id IS NOT NULL)\n\nCREATE UNIQUE INDEX uq_policy_room ON public.alert_policies USING btree (room_id, service_item_id, effective_from) WHERE (room_id IS NOT NULL)'
}

Table consumption_alerts [headercolor: #0284C7] {
  id bigint [pk, not null, increment]
  segment_id bigint [not null]
  policy_id bigint [not null]
  supersedes_alert_id bigint [unique]
  baseline_daily_average numeric(18,6)
  applied_threshold numeric(9,2) [not null]
  method varchar(40) [not null, default: 'WEIGHTED_DAILY']
  status varchar(30) [not null, default: 'PENDING']
  context_note text
  checked_by bigint
  checked_at timestamptz
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (segment_id, policy_id) [name: 'consumption_alerts_segment_id_policy_id_key', unique, type: btree]
  }

  checks {
    `((baseline_daily_average IS NULL) OR (baseline_daily_average >= (0)::numeric))` [name: 'consumption_alerts_baseline_daily_average_check']
    `(((status)::text <> ALL ((ARRAY['CONFIRMED'::character varying, 'DISMISSED'::character varying])::text[])) OR ((checked_by IS NOT NULL) AND (checked_at IS NOT NULL)))` [name: 'consumption_alerts_check']
    `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'CONFIRMED'::character varying, 'DISMISSED'::character varying, 'INSUFFICIENT_HISTORY'::character varying, 'INCOMPARABLE'::character varying])::text[]))` [name: 'consumption_alerts_status_check']
  }

  Note: 'Lần đánh giá, baseline và xác nhận có căn cứ'
}

Table alert_baseline_sources [headercolor: #0284C7] {
  id bigint [pk, not null, increment]
  alert_id bigint [not null]
  source_segment_id bigint [not null]

  indexes {
    (alert_id, source_segment_id) [name: 'alert_baseline_sources_alert_id_source_segment_id_key', unique, type: btree]
  }

  Note: 'Khoảng nào đã được dùng làm baseline'
}

