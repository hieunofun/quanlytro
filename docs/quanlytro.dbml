// Thiết kế mục tiêu bước 1–2. Nguồn: quanlytro.sql + database-rules.sql.
// 17 bảng; các giá trị tính toán nằm trong 6 view, không tạo bảng trùng dữ kiện.
Project QuanLyNhaTro {
  database_type: 'PostgreSQL'
}

Table users [headercolor: #315775] {
  id bigint [pk, not null, increment]
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `((role)::text = ANY ((ARRAY['ADMIN'::character varying, 'STAFF'::character varying, 'TENANT'::character varying])::text[]))` [name: 'users_role_check']
    `((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'LOCKED'::character varying, 'INACTIVE'::character varying])::text[]))` [name: 'users_status_check']
    `(btrim((username)::text) <> ''::text)` [name: 'users_username_check']
  }
}

Table employee_assignments [headercolor: #315775] {
  id bigint [pk, not null, increment]
  user_id bigint [not null]
  property_id bigint [not null]
  assigned_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  is_active boolean [not null, default: true]

  indexes {
    (user_id, property_id) [name: 'employee_assignments_user_id_property_id_key', unique, type: btree]
  }
}

Table properties [headercolor: #315775] {
  id bigint [pk, not null, increment]
  property_code varchar(30) [not null, unique]
  name varchar(150) [not null]
  address text [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  meter_cutoff_day smallint [not null, default: 28]
  invoice_issue_day smallint [not null, default: 1]
  alert_threshold_percentage numeric(7,2) [not null, default: 50]
  alert_history_months smallint [not null, default: 3]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `(btrim(address) <> ''::text)` [name: 'properties_address_check']
    `((alert_history_months >= 1) AND (alert_history_months <= 12))` [name: 'properties_alert_history_months_check']
    `(alert_threshold_percentage > (0)::numeric)` [name: 'properties_alert_threshold_percentage_check']
    `((invoice_issue_day >= 1) AND (invoice_issue_day <= 28))` [name: 'properties_invoice_issue_day_check']
    `((meter_cutoff_day >= 1) AND (meter_cutoff_day <= 31))` [name: 'properties_meter_cutoff_day_check']
    `(btrim((name)::text) <> ''::text)` [name: 'properties_name_check']
    `(btrim((property_code)::text) <> ''::text)` [name: 'properties_property_code_check']
    `((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'INACTIVE'::character varying])::text[]))` [name: 'properties_status_check']
  }
}

Table rooms [headercolor: #315775] {
  id bigint [pk, not null, increment]
  property_id bigint [not null]
  floor_number smallint [not null, default: 1]
  room_code varchar(30) [not null]
  base_price numeric(12,2) [not null]
  max_occupants smallint [not null, default: 2]
  area_sqm numeric(6,2)
  operational_status varchar(20) [not null, default: 'AVAILABLE', note: 'Tình trạng khai thác; trạng thái đang thuê suy ra từ hợp đồng.']
  description text [not null, default: '']
  internal_note text [not null, default: '']

  indexes {
    property_id [name: 'idx_rooms_property', type: btree]
    (property_id, room_code) [name: 'rooms_property_id_room_code_key', unique, type: btree]
  }

  checks {
    `(area_sqm > (0)::numeric)` [name: 'rooms_area_sqm_check']
    `(base_price >= (0)::numeric)` [name: 'rooms_base_price_check']
    `(floor_number >= 0)` [name: 'rooms_floor_number_check']
    `(max_occupants > 0)` [name: 'rooms_max_occupants_check']
    `((operational_status)::text = ANY ((ARRAY['AVAILABLE'::character varying, 'MAINTENANCE'::character varying])::text[]))` [name: 'rooms_operational_status_check']
    `(btrim((room_code)::text) <> ''::text)` [name: 'rooms_room_code_check']
  }
}

Table tenant_profiles [headercolor: #315775] {
  id bigint [pk, not null, increment]
  user_id bigint [unique]
  full_name varchar(100) [not null]
  identity_number varchar(20) [unique]
  phone varchar(20)
  email varchar(100)
  date_of_birth date
  hometown varchar(150)
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `(btrim((full_name)::text) <> ''::text)` [name: 'tenant_profiles_full_name_check']
  }
}

Table contracts [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_code varchar(50) [not null, unique]
  room_id bigint [not null]
  primary_tenant_id bigint [not null]
  start_date date [not null]
  end_date date [not null]
  actual_checkout_date date
  rental_price numeric(12,2) [not null]
  deposit_amount numeric(12,2) [not null, default: 0]
  payment_cycle_day smallint [not null, default: 5]
  status varchar(20) [not null, default: 'ACTIVE']
  terms text [not null, default: '']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    primary_tenant_id [name: 'idx_contract_tenant', type: btree]
  }

  checks {
    `(start_date < end_date)` [name: 'contracts_check']
    `((actual_checkout_date IS NULL) OR ((actual_checkout_date > start_date) AND (actual_checkout_date <= end_date)))` [name: 'contracts_check1']
    `(((status)::text = 'TERMINATED'::text) = (actual_checkout_date IS NOT NULL))` [name: 'contracts_check2']
    `(deposit_amount >= (0)::numeric)` [name: 'contracts_deposit_amount_check']
    `((payment_cycle_day >= 1) AND (payment_cycle_day <= 28))` [name: 'contracts_payment_cycle_day_check']
    `(rental_price >= (0)::numeric)` [name: 'contracts_rental_price_check']
    `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'ACTIVE'::character varying, 'TERMINATED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'contracts_status_check']
  }

  Note: 'PostgreSQL: CREATE INDEX ex_contract_room_period ON public.contracts USING gist (room_id, daterange(start_date, COALESCE(actual_checkout_date, end_date), \'[)\'::text)) WHERE ((status)::text <> \'CANCELLED\'::text)'
}

Table contract_members [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  tenant_id bigint [not null]
  relationship varchar(50)
  effective_from date [not null]
  effective_to date

  indexes {
    (contract_id, tenant_id, effective_from) [name: 'contract_members_contract_id_tenant_id_effective_from_key', unique, type: btree]
    tenant_id [name: 'idx_member_tenant', type: btree]
  }

  checks {
    `((effective_to IS NULL) OR (effective_from < effective_to))` [name: 'contract_members_check']
  }

  Note: 'PostgreSQL: CREATE INDEX ex_member_period ON public.contract_members USING gist (contract_id, tenant_id, daterange(effective_from, effective_to, \'[)\'::text))'
}

Table service_items [headercolor: #315775] {
  id bigint [pk, not null, increment]
  service_code varchar(30) [not null, unique]
  name varchar(100) [not null]
  calculation_type varchar(20) [not null]
  unit_name varchar(30) [not null]
  is_mandatory boolean [not null, default: true]

  checks {
    `((calculation_type)::text = ANY ((ARRAY['METER_BASED'::character varying, 'PER_ROOM'::character varying, 'PER_PERSON'::character varying])::text[]))` [name: 'service_items_calculation_type_check']
    `(btrim((name)::text) <> ''::text)` [name: 'service_items_name_check']
  }
}

Table service_price_configs [headercolor: #315775] {
  id bigint [pk, not null, increment]
  property_id bigint [not null]
  service_item_id bigint [not null]
  unit_price numeric(12,2) [not null]
  effective_from date [not null]

  indexes {
    (property_id, service_item_id, effective_from) [name: 'service_price_configs_property_id_service_item_id_effective_key', unique, type: btree]
  }

  checks {
    `(unit_price >= (0)::numeric)` [name: 'service_price_configs_unit_price_check']
  }
}

Table meter_readings [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  service_item_id bigint [not null]
  billing_period date [not null]
  old_index numeric(10,2) [not null]
  new_index numeric(10,2) [not null]
  reading_date date [not null]
  recorded_by bigint [not null]

  indexes {
    (contract_id, billing_period, service_item_id) [name: 'meter_readings_contract_id_billing_period_service_item_id_key', unique, type: btree]
  }

  checks {
    `(EXTRACT(day FROM billing_period) = (1)::numeric)` [name: 'meter_readings_billing_period_check']
    `(new_index >= old_index)` [name: 'meter_readings_check']
    `((reading_date >= billing_period) AND (reading_date < (billing_period + '1 mon'::interval)))` [name: 'meter_readings_check1']
    `(old_index >= (0)::numeric)` [name: 'meter_readings_old_index_check']
  }
}

Table consumption_alerts [headercolor: #315775] {
  id bigint [pk, not null, increment]
  meter_reading_id bigint [not null, unique]
  baseline_average numeric(12,2) [not null]
  applied_threshold_percentage numeric(7,2) [not null]
  history_months smallint [not null]
  status varchar(20) [not null, default: 'PENDING']
  checked_by bigint
  checked_at timestamptz
  note text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    status [name: 'idx_alert_status', type: btree]
  }

  checks {
    `(applied_threshold_percentage > (0)::numeric)` [name: 'consumption_alerts_applied_threshold_percentage_check']
    `(baseline_average > (0)::numeric)` [name: 'consumption_alerts_baseline_average_check']
    `((((status)::text = 'PENDING'::text) AND (checked_by IS NULL) AND (checked_at IS NULL)) OR (((status)::text <> 'PENDING'::text) AND (checked_by IS NOT NULL) AND (checked_at IS NOT NULL)))` [name: 'consumption_alerts_check']
    `((history_months >= 1) AND (history_months <= 12))` [name: 'consumption_alerts_history_months_check']
    `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'CONFIRMED'::character varying, 'DISMISSED'::character varying])::text[]))` [name: 'consumption_alerts_status_check']
  }
}

Table invoices [headercolor: #315775] {
  id bigint [pk, not null, increment]
  invoice_code varchar(50) [not null, unique]
  contract_id bigint [not null]
  billing_period date [not null]
  issue_date date [not null]
  due_date date [not null]
  status varchar(20) [not null, default: 'DRAFT']
  is_settlement boolean [not null, default: false]
  issued_at timestamptz

  indexes {
    contract_id [name: 'idx_invoice_contract', type: btree]
    (contract_id, billing_period) [name: 'invoices_contract_id_billing_period_key', unique, type: btree]
  }

  checks {
    `(EXTRACT(day FROM billing_period) = (1)::numeric)` [name: 'invoices_billing_period_check']
    `(due_date >= issue_date)` [name: 'invoices_check']
    `((((status)::text = 'DRAFT'::text) AND (issued_at IS NULL)) OR (((status)::text = 'ISSUED'::text) AND (issued_at IS NOT NULL)))` [name: 'invoices_check1']
    `((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'ISSUED'::character varying])::text[]))` [name: 'invoices_status_check']
  }
}

Table invoice_items [headercolor: #315775] {
  id bigint [pk, not null, increment]
  invoice_id bigint [not null]
  service_item_id bigint
  meter_reading_id bigint [unique]
  item_name_snapshot varchar(100) [not null]
  unit_name_snapshot varchar(30) [not null]
  unit_price_snapshot numeric(12,2) [not null]
  quantity integer [note: 'Ngày ở/ngày-người cho khoản thu tháng; NULL khi tham chiếu chỉ số đo đếm.']

  indexes {
    (invoice_id, service_item_id) [name: 'invoice_items_invoice_id_service_item_id_key', unique, type: btree]
  }

  checks {
    `(((meter_reading_id IS NOT NULL) AND (service_item_id IS NULL) AND (quantity IS NULL)) OR ((meter_reading_id IS NULL) AND (quantity IS NOT NULL) AND (quantity > 0)))` [name: 'invoice_items_check']
    `(unit_price_snapshot >= (0)::numeric)` [name: 'invoice_items_unit_price_snapshot_check']
  }

  Note: 'PostgreSQL: CREATE UNIQUE INDEX uq_invoice_room_line ON public.invoice_items USING btree (invoice_id) WHERE ((service_item_id IS NULL) AND (meter_reading_id IS NULL))'
}

Table payment_transactions [headercolor: #315775] {
  id bigint [pk, not null, increment]
  invoice_id bigint [not null]
  transaction_code varchar(50) [not null, unique]
  amount numeric(12,2) [not null]
  payment_method varchar(30) [not null]
  payment_date timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  received_by bigint [not null]
  notes text

  indexes {
    invoice_id [name: 'idx_payment_invoice', type: btree]
  }

  checks {
    `(amount > (0)::numeric)` [name: 'payment_transactions_amount_check']
    `((payment_method)::text = ANY ((ARRAY['CASH'::character varying, 'BANK_TRANSFER_MANUAL'::character varying, 'DEPOSIT_OFFSET'::character varying, 'OTHER'::character varying])::text[]))` [name: 'payment_transactions_payment_method_check']
  }
}

Table checkout_records [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null, unique]
  deposit_snapshot numeric(12,2) [not null]
  outstanding_snapshot numeric(14,2) [not null]
  damage_amount numeric(12,2) [not null, default: 0]
  settled_by bigint [not null]
  settled_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  notes text

  checks {
    `(damage_amount >= (0)::numeric)` [name: 'checkout_records_damage_amount_check']
    `(deposit_snapshot >= (0)::numeric)` [name: 'checkout_records_deposit_snapshot_check']
    `(outstanding_snapshot >= (0)::numeric)` [name: 'checkout_records_outstanding_snapshot_check']
  }
}

Table maintenance_requests [headercolor: #315775] {
  id bigint [pk, not null, increment]
  contract_id bigint [not null]
  submitted_by bigint [not null]
  assigned_to bigint
  title varchar(150) [not null]
  description text [not null]
  priority varchar(20) [not null, default: 'NORMAL']
  status varchar(20) [not null, default: 'NEW']
  expected_date date [not null]
  actual_cost numeric(12,2) [not null, default: 0]
  progress_note text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    contract_id [name: 'idx_maintenance_contract', type: btree]
  }

  checks {
    `(actual_cost >= (0)::numeric)` [name: 'maintenance_requests_actual_cost_check']
    `(btrim(description) <> ''::text)` [name: 'maintenance_requests_description_check']
    `((priority)::text = ANY ((ARRAY['URGENT'::character varying, 'NORMAL'::character varying, 'LOW'::character varying])::text[]))` [name: 'maintenance_requests_priority_check']
    `((status)::text = ANY ((ARRAY['NEW'::character varying, 'ACCEPTED'::character varying, 'IN_PROGRESS'::character varying, 'COMPLETED'::character varying])::text[]))` [name: 'maintenance_requests_status_check']
    `(btrim((title)::text) <> ''::text)` [name: 'maintenance_requests_title_check']
  }
}

Table maintenance_images [headercolor: #315775] {
  id bigint [pk, not null, increment]
  maintenance_request_id bigint [not null]
  url text [not null]
  uploaded_by bigint [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (maintenance_request_id, url) [name: 'maintenance_images_maintenance_request_id_url_key', unique, type: btree]
  }

  checks {
    `(btrim(url) <> ''::text)` [name: 'maintenance_images_url_check']
  }
}

Ref checkout_records_contract_id_fkey: contracts.id - checkout_records.contract_id [delete: restrict]
Ref checkout_records_settled_by_fkey: checkout_records.settled_by > users.id [delete: restrict]
Ref consumption_alerts_checked_by_fkey: consumption_alerts.checked_by >? users.id [delete: restrict]
Ref consumption_alerts_meter_reading_id_fkey: meter_readings.id - consumption_alerts.meter_reading_id [delete: cascade]
Ref contract_members_contract_id_fkey: contract_members.contract_id > contracts.id [delete: restrict]
Ref contract_members_tenant_id_fkey: contract_members.tenant_id > tenant_profiles.id [delete: restrict]
Ref contracts_primary_tenant_id_fkey: contracts.primary_tenant_id > tenant_profiles.id [delete: restrict]
Ref contracts_room_id_fkey: contracts.room_id > rooms.id [delete: restrict]
Ref employee_assignments_property_id_fkey: employee_assignments.property_id > properties.id [delete: restrict]
Ref employee_assignments_user_id_fkey: employee_assignments.user_id > users.id [delete: restrict]
Ref invoice_items_invoice_id_fkey: invoice_items.invoice_id > invoices.id [delete: cascade]
Ref invoice_items_meter_reading_id_fkey: meter_readings.id ?- invoice_items.meter_reading_id [delete: restrict]
Ref invoice_items_service_item_id_fkey: invoice_items.service_item_id >? service_items.id [delete: restrict]
Ref invoices_contract_id_fkey: invoices.contract_id > contracts.id [delete: restrict]
Ref maintenance_images_maintenance_request_id_fkey: maintenance_images.maintenance_request_id > maintenance_requests.id [delete: cascade]
Ref maintenance_images_uploaded_by_fkey: maintenance_images.uploaded_by > users.id [delete: restrict]
Ref maintenance_requests_assigned_to_fkey: maintenance_requests.assigned_to >? users.id [delete: restrict]
Ref maintenance_requests_contract_id_fkey: maintenance_requests.contract_id > contracts.id [delete: restrict]
Ref maintenance_requests_submitted_by_fkey: maintenance_requests.submitted_by > users.id [delete: restrict]
Ref meter_readings_contract_id_fkey: meter_readings.contract_id > contracts.id [delete: restrict]
Ref meter_readings_recorded_by_fkey: meter_readings.recorded_by > users.id [delete: restrict]
Ref meter_readings_service_item_id_fkey: meter_readings.service_item_id > service_items.id [delete: restrict]
Ref payment_transactions_invoice_id_fkey: payment_transactions.invoice_id > invoices.id [delete: restrict]
Ref payment_transactions_received_by_fkey: payment_transactions.received_by > users.id [delete: restrict]
Ref rooms_property_id_fkey: rooms.property_id > properties.id [delete: restrict]
Ref service_price_configs_property_id_fkey: service_price_configs.property_id > properties.id [delete: restrict]
Ref service_price_configs_service_item_id_fkey: service_price_configs.service_item_id > service_items.id [delete: restrict]
Ref tenant_profiles_user_id_fkey: users.id ?- tenant_profiles.user_id [delete: set null]

TableGroup TaiKhoan {
  users
  employee_assignments
}

TableGroup NhaTro {
  properties
  rooms
}

TableGroup CuTru {
  tenant_profiles
  contracts
  contract_members
}

TableGroup DienNuoc {
  service_items
  service_price_configs
  meter_readings
  consumption_alerts
}

TableGroup TaiChinh {
  invoices
  invoice_items
  payment_transactions
  checkout_records
}

TableGroup SuCo {
  maintenance_requests
  maintenance_images
}
