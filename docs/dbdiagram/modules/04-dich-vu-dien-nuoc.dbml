// FK có bảng nguồn trong nhóm
Ref alert_baseline_sources_alert_id_fkey: alert_baseline_sources.alert_id > consumption_alerts.id [delete: no action, update: no action]
Ref alert_baseline_sources_source_segment_id_fkey: alert_baseline_sources.source_segment_id > consumption_segments.id [delete: no action, update: no action]
Ref alert_policies_property_id_fkey: alert_policies.property_id >? properties.id [delete: no action, update: no action]
Ref alert_policies_room_id_fkey: alert_policies.room_id >? rooms.id [delete: no action, update: no action]
Ref alert_policies_service_item_id_fkey: alert_policies.service_item_id > service_items.id [delete: no action, update: no action]
Ref consumption_alerts_checked_by_fkey: consumption_alerts.checked_by >? users.id [delete: no action, update: no action]
Ref consumption_alerts_policy_id_fkey: consumption_alerts.policy_id > alert_policies.id [delete: no action, update: no action]
Ref consumption_alerts_segment_id_fkey: consumption_alerts.segment_id > consumption_segments.id [delete: no action, update: no action]
Ref consumption_alerts_supersedes_alert_id_fkey: consumption_alerts.id ?- consumption_alerts.supersedes_alert_id [delete: no action, update: no action]
Ref consumption_segments_contract_id_fkey: consumption_segments.contract_id >? contracts.id [delete: no action, update: no action]
Ref consumption_segments_end_reading_id_fkey: consumption_segments.end_reading_id > meter_readings.id [delete: no action, update: no action]
Ref consumption_segments_recorded_by_fkey: consumption_segments.recorded_by >? users.id [delete: no action, update: no action]
Ref consumption_segments_start_reading_id_fkey: consumption_segments.start_reading_id > meter_readings.id [delete: no action, update: no action]
Ref consumption_segments_supersedes_segment_id_fkey: consumption_segments.id ?- consumption_segments.supersedes_segment_id [delete: no action, update: no action]
Ref contract_service_subscriptions_contract_id_fkey: contract_service_subscriptions.contract_id > contracts.id [delete: no action, update: no action]
Ref contract_service_subscriptions_recorded_by_fkey: contract_service_subscriptions.recorded_by >? users.id [delete: no action, update: no action]
Ref contract_service_subscriptions_service_item_id_fkey: contract_service_subscriptions.service_item_id > service_items.id [delete: no action, update: no action]
Ref meter_readings_correction_item_id_fkey: billing_items.id ?- meter_readings.correction_item_id [delete: no action, update: no action]
Ref meter_readings_handover_id_fkey: meter_readings.handover_id >? handovers.id [delete: no action, update: no action]
Ref meter_readings_meter_id_fkey: meter_readings.meter_id > meters.id [delete: no action, update: no action]
Ref meter_readings_recorded_by_fkey: meter_readings.recorded_by > users.id [delete: no action, update: no action]
Ref meter_readings_supersedes_reading_id_fkey: meter_readings.id ?- meter_readings.supersedes_reading_id [delete: no action, update: no action]
Ref meters_recorded_by_fkey: meters.recorded_by >? users.id [delete: no action, update: no action]
Ref meters_room_id_fkey: meters.room_id > rooms.id [delete: no action, update: no action]
Ref meters_service_item_id_fkey: meters.service_item_id > service_items.id [delete: no action, update: no action]
Ref service_price_configs_property_id_fkey: service_price_configs.property_id > properties.id [delete: no action, update: no action]
Ref service_price_configs_recorded_by_fkey: service_price_configs.recorded_by >? users.id [delete: no action, update: no action]
Ref service_price_configs_service_item_id_fkey: service_price_configs.service_item_id > service_items.id [delete: no action, update: no action]

