// FK có bảng nguồn trong nhóm
Ref maintenance_costs_advanced_by_tenant_id_fkey: maintenance_costs.advanced_by_tenant_id >? tenant_profiles.id [delete: no action, update: no action]
Ref maintenance_costs_recorded_by_fkey: maintenance_costs.recorded_by > users.id [delete: no action, update: no action]
Ref maintenance_costs_request_id_fkey: maintenance_costs.request_id > maintenance_requests.id [delete: no action, update: no action]
Ref maintenance_events_actor_id_fkey: maintenance_events.actor_id > users.id [delete: no action, update: no action]
Ref maintenance_events_request_id_fkey: maintenance_events.request_id > maintenance_requests.id [delete: no action, update: no action]
Ref maintenance_requests_asset_placement_id_fkey: maintenance_requests.asset_placement_id >? asset_placements.id [delete: no action, update: no action]
Ref maintenance_requests_assigned_to_fkey: maintenance_requests.assigned_to >? users.id [delete: no action, update: no action]
Ref maintenance_requests_property_id_fkey: maintenance_requests.property_id >? properties.id [delete: no action, update: no action]
Ref maintenance_requests_room_id_fkey: maintenance_requests.room_id >? rooms.id [delete: no action, update: no action]
Ref maintenance_requests_schedule_id_fkey: maintenance_requests.schedule_id >? maintenance_schedules.id [delete: no action, update: no action]
Ref maintenance_requests_submitted_by_fkey: maintenance_requests.submitted_by > users.id [delete: no action, update: no action]
Ref maintenance_schedules_asset_id_fkey: maintenance_schedules.asset_id >? assets.id [delete: no action, update: no action]
Ref maintenance_schedules_created_by_fkey: maintenance_schedules.created_by >? users.id [delete: no action, update: no action]
Ref maintenance_schedules_property_id_fkey: maintenance_schedules.property_id >? properties.id [delete: no action, update: no action]
Ref maintenance_schedules_room_id_fkey: maintenance_schedules.room_id >? rooms.id [delete: no action, update: no action]

TableGroup SuCo [color: #B45309] {
  maintenance_schedules
  maintenance_requests
  maintenance_events
  maintenance_costs
}

