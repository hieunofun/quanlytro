// FK có bảng nguồn trong nhóm
Ref file_attachments_asset_id_fkey: file_attachments.asset_id >? assets.id [delete: no action, update: no action]
Ref file_attachments_attached_by_fkey: file_attachments.attached_by > users.id [delete: no action, update: no action]
Ref file_attachments_billing_document_id_fkey: file_attachments.billing_document_id >? billing_documents.id [delete: no action, update: no action]
Ref file_attachments_contract_term_id_fkey: file_attachments.contract_term_id >? contract_terms.id [delete: no action, update: no action]
Ref file_attachments_file_id_fkey: file_attachments.file_id > stored_files.id [delete: no action, update: no action]
Ref file_attachments_fund_entry_id_fkey: file_attachments.fund_entry_id >? fund_entries.id [delete: no action, update: no action]
Ref file_attachments_handover_item_id_fkey: file_attachments.handover_item_id >? handover_items.id [delete: no action, update: no action]
Ref file_attachments_maintenance_cost_id_fkey: file_attachments.maintenance_cost_id >? maintenance_costs.id [delete: no action, update: no action]
Ref file_attachments_maintenance_request_id_fkey: file_attachments.maintenance_request_id >? maintenance_requests.id [delete: no action, update: no action]
Ref file_attachments_meter_reading_id_fkey: file_attachments.meter_reading_id >? meter_readings.id [delete: no action, update: no action]
Ref file_attachments_room_id_fkey: file_attachments.room_id >? rooms.id [delete: no action, update: no action]
Ref file_attachments_violation_id_fkey: file_attachments.violation_id >? contract_violations.id [delete: no action, update: no action]
Ref stored_files_uploaded_by_fkey: stored_files.uploaded_by > users.id [delete: no action, update: no action]

TableGroup Tep [color: #4D7C0F] {
  stored_files
  file_attachments
}

TableGroup ThamChieuRutGon [color: #64748B] {
  assets
  billing_documents
  contract_terms
  contract_violations
  fund_entries
  handover_items
  maintenance_costs
  maintenance_requests
  meter_readings
  rooms
  users
}
