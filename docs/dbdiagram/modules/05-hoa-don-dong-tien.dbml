// FK có bảng nguồn trong nhóm
Ref billing_documents_checkout_id_fkey: billing_documents.checkout_id >? checkout_records.id [delete: no action, update: no action]
Ref billing_documents_contract_id_fkey: billing_documents.contract_id >? contracts.id [delete: no action, update: no action]
Ref billing_documents_created_by_fkey: billing_documents.created_by >? users.id [delete: no action, update: no action]
Ref billing_documents_issued_by_fkey: billing_documents.issued_by >? users.id [delete: no action, update: no action]
Ref billing_documents_related_document_id_fkey: billing_documents.related_document_id >? billing_documents.id [delete: no action, update: no action]
Ref billing_documents_reservation_id_fkey: billing_documents.reservation_id >? reservations.id [delete: no action, update: no action]
Ref billing_items_adjusts_item_id_fkey: billing_items.adjusts_item_id >? billing_items.id [delete: no action, update: no action]
Ref billing_items_contract_term_id_fkey: billing_items.contract_term_id >? contract_terms.id [delete: no action, update: no action]
Ref billing_items_document_id_fkey: billing_items.document_id > billing_documents.id [delete: no action, update: no action]
Ref billing_items_handover_item_id_fkey: billing_items.handover_item_id >? handover_items.id [delete: no action, update: no action]
Ref billing_items_maintenance_cost_id_fkey: billing_items.maintenance_cost_id >? maintenance_costs.id [delete: no action, update: no action]
Ref billing_items_segment_id_fkey: billing_items.segment_id >? consumption_segments.id [delete: no action, update: no action]
Ref billing_items_service_price_config_id_fkey: billing_items.service_price_config_id >? service_price_configs.id [delete: no action, update: no action]
Ref billing_items_subscription_id_fkey: billing_items.subscription_id >? contract_service_subscriptions.id [delete: no action, update: no action]
Ref billing_items_violation_id_fkey: billing_items.violation_id >? contract_violations.id [delete: no action, update: no action]
Ref cash_accounts_property_id_fkey: cash_accounts.property_id >? properties.id [delete: no action, update: no action]
Ref cash_transactions_cash_account_id_fkey: cash_transactions.cash_account_id > cash_accounts.id [delete: no action, update: no action]
