digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="1.05", splines=polyline, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#6B7280", arrowsize=0.6];
contracts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contracts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="reservation_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK reservation_id</FONT></TD></TR><TR><TD PORT="previous_contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK previous_contract_id</FONT></TD></TR><TR><TD PORT="start_date" ALIGN="LEFT"><FONT POINT-SIZE="12">start_date</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="created_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK created_by</FONT></TD></TR></TABLE>>];
reservations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>reservations</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id</FONT></TD></TR><TR><TD PORT="tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK tenant_id</FONT></TD></TR><TR><TD PORT="start_date" ALIGN="LEFT"><FONT POINT-SIZE="12">start_date</FONT></TD></TR><TR><TD PORT="end_date" ALIGN="LEFT"><FONT POINT-SIZE="12">end_date</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="created_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK created_by</FONT></TD></TR></TABLE>>];
billing_documents [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>billing_documents</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="reservation_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK reservation_id</FONT></TD></TR><TR><TD PORT="checkout_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK checkout_id</FONT></TD></TR><TR><TD PORT="related_document_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK related_document_id</FONT></TD></TR><TR><TD PORT="billing_period" ALIGN="LEFT"><FONT POINT-SIZE="12">billing_period</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="created_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK created_by</FONT></TD></TR><TR><TD PORT="issued_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK issued_by</FONT></TD></TR></TABLE>>];
billing_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>billing_items</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK document_id</FONT></TD></TR><TR><TD PORT="adjusts_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK adjusts_item_id</FONT></TD></TR><TR><TD PORT="contract_term_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_term_id</FONT></TD></TR><TR><TD PORT="subscription_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK subscription_id</FONT></TD></TR><TR><TD PORT="segment_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK segment_id</FONT></TD></TR><TR><TD PORT="service_price_config_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_price_config_id</FONT></TD></TR><TR><TD PORT="handover_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK handover_item_id</FONT></TD></TR><TR><TD PORT="maintenance_cost_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK maintenance_cost_id</FONT></TD></TR><TR><TD PORT="violation_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK violation_id</FONT></TD></TR></TABLE>>];
cash_accounts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>cash_accounts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id</FONT></TD></TR></TABLE>>];
cash_transactions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>cash_transactions</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="payment_document_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK payment_document_id</FONT></TD></TR><TR><TD PORT="cash_account_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK cash_account_id</FONT></TD></TR><TR><TD PORT="payer_or_payee_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK payer_or_payee_id</FONT></TD></TR><TR><TD PORT="amount" ALIGN="LEFT"><FONT POINT-SIZE="12">amount</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by</FONT></TD></TR><TR><TD PORT="confirmed_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK confirmed_by</FONT></TD></TR></TABLE>>];
fund_accounts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>fund_accounts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="reservation_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK reservation_id</FONT></TD></TR><TR><TD PORT="unapplied_receipt_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK unapplied_receipt_id</FONT></TD></TR><TR><TD PORT="beneficiary_tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK beneficiary_tenant_id</FONT></TD></TR></TABLE>>];
fund_entries [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>fund_entries</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="cash_transaction_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK cash_transaction_id</FONT></TD></TR><TR><TD PORT="from_fund_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK from_fund_id</FONT></TD></TR><TR><TD PORT="to_fund_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK to_fund_id</FONT></TD></TR><TR><TD PORT="debit_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK debit_item_id</FONT></TD></TR><TR><TD PORT="credit_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK credit_item_id</FONT></TD></TR><TR><TD PORT="original_entry_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK original_entry_id</FONT></TD></TR><TR><TD PORT="amount" ALIGN="LEFT"><FONT POINT-SIZE="12">amount</FONT></TD></TR><TR><TD PORT="posted_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK posted_by</FONT></TD></TR></TABLE>>];
fund_holds [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>fund_holds</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="fund_account_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK fund_account_id</FONT></TD></TR><TR><TD PORT="related_billing_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK related_billing_item_id</FONT></TD></TR><TR><TD PORT="amount" ALIGN="LEFT"><FONT POINT-SIZE="12">amount</FONT></TD></TR><TR><TD PORT="created_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK created_by</FONT></TD></TR></TABLE>>];
checkout_records [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>checkout_records</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id</FONT></TD></TR><TR><TD PORT="return_handover_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK return_handover_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="approved_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK approved_by</FONT></TD></TR></TABLE>>];
checkout_records:id -> billing_documents:checkout_id [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> billing_documents:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
billing_documents:id -> billing_documents:related_document_id [dir=both, arrowtail=tee, arrowhead=crow];
reservations:id -> billing_documents:reservation_id [dir=both, arrowtail=tee, arrowhead=crow];
billing_items:id -> billing_items:adjusts_item_id [dir=both, arrowtail=tee, arrowhead=crow];
billing_documents:id -> billing_items:document_id [dir=both, arrowtail=tee, arrowhead=crow];
cash_accounts:id -> cash_transactions:cash_account_id [dir=both, arrowtail=tee, arrowhead=crow];
billing_documents:id -> cash_transactions:payment_document_id [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> checkout_records:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
contracts:id -> contracts:previous_contract_id [dir=both, arrowtail=tee, arrowhead=crow];
reservations:id -> contracts:reservation_id [dir=both, arrowtail=tee, arrowhead=tee];
contracts:id -> fund_accounts:contract_id [dir=both, arrowtail=tee, arrowhead=crow];
reservations:id -> fund_accounts:reservation_id [dir=both, arrowtail=tee, arrowhead=crow];
cash_transactions:id -> fund_accounts:unapplied_receipt_id [dir=both, arrowtail=tee, arrowhead=tee];
cash_transactions:id -> fund_entries:cash_transaction_id [dir=both, arrowtail=tee, arrowhead=crow];
billing_items:id -> fund_entries:credit_item_id [dir=both, arrowtail=tee, arrowhead=crow];
billing_items:id -> fund_entries:debit_item_id [dir=both, arrowtail=tee, arrowhead=crow];
fund_accounts:id -> fund_entries:from_fund_id [dir=both, arrowtail=tee, arrowhead=crow];
fund_entries:id -> fund_entries:original_entry_id [dir=both, arrowtail=tee, arrowhead=crow];
fund_accounts:id -> fund_entries:to_fund_id [dir=both, arrowtail=tee, arrowhead=crow];
fund_accounts:id -> fund_holds:fund_account_id [dir=both, arrowtail=tee, arrowhead=crow];
billing_items:id -> fund_holds:related_billing_item_id [dir=both, arrowtail=tee, arrowhead=crow];
}
