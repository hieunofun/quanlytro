digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="1.05", splines=polyline, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#6B7280", arrowsize=0.6];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>users</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="username" ALIGN="LEFT"><FONT POINT-SIZE="12">username : varchar(50)</FONT></TD></TR><TR><TD PORT="password_hash" ALIGN="LEFT"><FONT POINT-SIZE="12">password_hash : varchar(255)</FONT></TD></TR><TR><TD PORT="role" ALIGN="LEFT"><FONT POINT-SIZE="12">role : varchar(20)</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status : varchar(20)</FONT></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT"><FONT POINT-SIZE="12">created_at : timestamptz</FONT></TD></TR></TABLE>>];
employee_assignments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>employee_assignments</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK user_id : bigint</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id : bigint</FONT></TD></TR><TR><TD PORT="assigned_at" ALIGN="LEFT"><FONT POINT-SIZE="12">assigned_at : timestamptz</FONT></TD></TR><TR><TD PORT="is_active" ALIGN="LEFT"><FONT POINT-SIZE="12">is_active : boolean</FONT></TD></TR></TABLE>>];
properties [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>properties</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="property_code" ALIGN="LEFT"><FONT POINT-SIZE="12">property_code : varchar(30)</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT POINT-SIZE="12">name : varchar(150)</FONT></TD></TR><TR><TD PORT="address" ALIGN="LEFT"><FONT POINT-SIZE="12">address : text</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status : varchar(20)</FONT></TD></TR><TR><TD PORT="meter_cutoff_day" ALIGN="LEFT"><FONT POINT-SIZE="12">meter_cutoff_day : smallint</FONT></TD></TR><TR><TD PORT="invoice_issue_day" ALIGN="LEFT"><FONT POINT-SIZE="12">invoice_issue_day : smallint</FONT></TD></TR><TR><TD PORT="alert_threshold_percentage" ALIGN="LEFT"><FONT POINT-SIZE="12">alert_threshold_percentage : numeric(7,2)</FONT></TD></TR><TR><TD PORT="alert_history_months" ALIGN="LEFT"><FONT POINT-SIZE="12">alert_history_months : smallint</FONT></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT"><FONT POINT-SIZE="12">created_at : timestamptz</FONT></TD></TR></TABLE>>];
rooms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>rooms</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id : bigint</FONT></TD></TR><TR><TD PORT="floor_number" ALIGN="LEFT"><FONT POINT-SIZE="12">floor_number : smallint</FONT></TD></TR><TR><TD PORT="room_code" ALIGN="LEFT"><FONT POINT-SIZE="12">room_code : varchar(30)</FONT></TD></TR><TR><TD PORT="base_price" ALIGN="LEFT"><FONT POINT-SIZE="12">base_price : numeric(12,2)</FONT></TD></TR><TR><TD PORT="max_occupants" ALIGN="LEFT"><FONT POINT-SIZE="12">max_occupants : smallint</FONT></TD></TR><TR><TD PORT="area_sqm" ALIGN="LEFT"><FONT POINT-SIZE="12">area_sqm : numeric(6,2)</FONT></TD></TR><TR><TD PORT="operational_status" ALIGN="LEFT"><FONT POINT-SIZE="12">operational_status : varchar(20)</FONT></TD></TR><TR><TD PORT="description" ALIGN="LEFT"><FONT POINT-SIZE="12">description : text</FONT></TD></TR><TR><TD PORT="internal_note" ALIGN="LEFT"><FONT POINT-SIZE="12">internal_note : text</FONT></TD></TR></TABLE>>];
tenant_profiles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>tenant_profiles</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK user_id : bigint</FONT></TD></TR><TR><TD PORT="full_name" ALIGN="LEFT"><FONT POINT-SIZE="12">full_name : varchar(100)</FONT></TD></TR><TR><TD PORT="identity_number" ALIGN="LEFT"><FONT POINT-SIZE="12">identity_number : varchar(20)</FONT></TD></TR><TR><TD PORT="phone" ALIGN="LEFT"><FONT POINT-SIZE="12">phone : varchar(20)</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><FONT POINT-SIZE="12">email : varchar(100)</FONT></TD></TR><TR><TD PORT="date_of_birth" ALIGN="LEFT"><FONT POINT-SIZE="12">date_of_birth : date</FONT></TD></TR><TR><TD PORT="hometown" ALIGN="LEFT"><FONT POINT-SIZE="12">hometown : varchar(150)</FONT></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT"><FONT POINT-SIZE="12">created_at : timestamptz</FONT></TD></TR></TABLE>>];
contracts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contracts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="contract_code" ALIGN="LEFT"><FONT POINT-SIZE="12">contract_code : varchar(50)</FONT></TD></TR><TR><TD PORT="room_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK room_id : bigint</FONT></TD></TR><TR><TD PORT="primary_tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK primary_tenant_id : bigint</FONT></TD></TR><TR><TD PORT="start_date" ALIGN="LEFT"><FONT POINT-SIZE="12">start_date : date</FONT></TD></TR><TR><TD PORT="end_date" ALIGN="LEFT"><FONT POINT-SIZE="12">end_date : date</FONT></TD></TR><TR><TD PORT="actual_checkout_date" ALIGN="LEFT"><FONT POINT-SIZE="12">actual_checkout_date : date</FONT></TD></TR><TR><TD PORT="rental_price" ALIGN="LEFT"><FONT POINT-SIZE="12">rental_price : numeric(12,2)</FONT></TD></TR><TR><TD PORT="deposit_amount" ALIGN="LEFT"><FONT POINT-SIZE="12">deposit_amount : numeric(12,2)</FONT></TD></TR><TR><TD PORT="payment_cycle_day" ALIGN="LEFT"><FONT POINT-SIZE="12">payment_cycle_day : smallint</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status : varchar(20)</FONT></TD></TR><TR><TD PORT="terms" ALIGN="LEFT"><FONT POINT-SIZE="12">terms : text</FONT></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT"><FONT POINT-SIZE="12">created_at : timestamptz</FONT></TD></TR></TABLE>>];
contract_members [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>contract_members</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id : bigint</FONT></TD></TR><TR><TD PORT="tenant_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK tenant_id : bigint</FONT></TD></TR><TR><TD PORT="relationship" ALIGN="LEFT"><FONT POINT-SIZE="12">relationship : varchar(50)</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from : date</FONT></TD></TR><TR><TD PORT="effective_to" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_to : date</FONT></TD></TR></TABLE>>];
service_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>service_items</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="service_code" ALIGN="LEFT"><FONT POINT-SIZE="12">service_code : varchar(30)</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT POINT-SIZE="12">name : varchar(100)</FONT></TD></TR><TR><TD PORT="calculation_type" ALIGN="LEFT"><FONT POINT-SIZE="12">calculation_type : varchar(20)</FONT></TD></TR><TR><TD PORT="unit_name" ALIGN="LEFT"><FONT POINT-SIZE="12">unit_name : varchar(30)</FONT></TD></TR><TR><TD PORT="is_mandatory" ALIGN="LEFT"><FONT POINT-SIZE="12">is_mandatory : boolean</FONT></TD></TR></TABLE>>];
service_price_configs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>service_price_configs</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="property_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK property_id : bigint</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id : bigint</FONT></TD></TR><TR><TD PORT="unit_price" ALIGN="LEFT"><FONT POINT-SIZE="12">unit_price : numeric(12,2)</FONT></TD></TR><TR><TD PORT="effective_from" ALIGN="LEFT"><FONT POINT-SIZE="12">effective_from : date</FONT></TD></TR></TABLE>>];
meter_readings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>meter_readings</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id : bigint</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id : bigint</FONT></TD></TR><TR><TD PORT="billing_period" ALIGN="LEFT"><FONT POINT-SIZE="12">billing_period : date</FONT></TD></TR><TR><TD PORT="old_index" ALIGN="LEFT"><FONT POINT-SIZE="12">old_index : numeric(10,2)</FONT></TD></TR><TR><TD PORT="new_index" ALIGN="LEFT"><FONT POINT-SIZE="12">new_index : numeric(10,2)</FONT></TD></TR><TR><TD PORT="reading_date" ALIGN="LEFT"><FONT POINT-SIZE="12">reading_date : date</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK recorded_by : bigint</FONT></TD></TR></TABLE>>];
consumption_alerts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>consumption_alerts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="meter_reading_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK meter_reading_id : bigint</FONT></TD></TR><TR><TD PORT="baseline_average" ALIGN="LEFT"><FONT POINT-SIZE="12">baseline_average : numeric(12,2)</FONT></TD></TR><TR><TD PORT="applied_threshold_percentage" ALIGN="LEFT"><FONT POINT-SIZE="12">applied_threshold_percentage : numeric(7,2)</FONT></TD></TR><TR><TD PORT="history_months" ALIGN="LEFT"><FONT POINT-SIZE="12">history_months : smallint</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status : varchar(20)</FONT></TD></TR><TR><TD PORT="checked_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK checked_by : bigint</FONT></TD></TR><TR><TD PORT="checked_at" ALIGN="LEFT"><FONT POINT-SIZE="12">checked_at : timestamptz</FONT></TD></TR><TR><TD PORT="note" ALIGN="LEFT"><FONT POINT-SIZE="12">note : text</FONT></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT"><FONT POINT-SIZE="12">created_at : timestamptz</FONT></TD></TR></TABLE>>];
invoices [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>invoices</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="invoice_code" ALIGN="LEFT"><FONT POINT-SIZE="12">invoice_code : varchar(50)</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id : bigint</FONT></TD></TR><TR><TD PORT="billing_period" ALIGN="LEFT"><FONT POINT-SIZE="12">billing_period : date</FONT></TD></TR><TR><TD PORT="issue_date" ALIGN="LEFT"><FONT POINT-SIZE="12">issue_date : date</FONT></TD></TR><TR><TD PORT="due_date" ALIGN="LEFT"><FONT POINT-SIZE="12">due_date : date</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status : varchar(20)</FONT></TD></TR><TR><TD PORT="is_settlement" ALIGN="LEFT"><FONT POINT-SIZE="12">is_settlement : boolean</FONT></TD></TR><TR><TD PORT="issued_at" ALIGN="LEFT"><FONT POINT-SIZE="12">issued_at : timestamptz</FONT></TD></TR></TABLE>>];
invoice_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>invoice_items</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="invoice_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK invoice_id : bigint</FONT></TD></TR><TR><TD PORT="service_item_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK service_item_id : bigint</FONT></TD></TR><TR><TD PORT="meter_reading_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK meter_reading_id : bigint</FONT></TD></TR><TR><TD PORT="item_name_snapshot" ALIGN="LEFT"><FONT POINT-SIZE="12">item_name_snapshot : varchar(100)</FONT></TD></TR><TR><TD PORT="unit_name_snapshot" ALIGN="LEFT"><FONT POINT-SIZE="12">unit_name_snapshot : varchar(30)</FONT></TD></TR><TR><TD PORT="unit_price_snapshot" ALIGN="LEFT"><FONT POINT-SIZE="12">unit_price_snapshot : numeric(12,2)</FONT></TD></TR><TR><TD PORT="quantity" ALIGN="LEFT"><FONT POINT-SIZE="12">quantity : integer</FONT></TD></TR></TABLE>>];
payment_transactions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>payment_transactions</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="invoice_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK invoice_id : bigint</FONT></TD></TR><TR><TD PORT="transaction_code" ALIGN="LEFT"><FONT POINT-SIZE="12">transaction_code : varchar(50)</FONT></TD></TR><TR><TD PORT="amount" ALIGN="LEFT"><FONT POINT-SIZE="12">amount : numeric(12,2)</FONT></TD></TR><TR><TD PORT="payment_method" ALIGN="LEFT"><FONT POINT-SIZE="12">payment_method : varchar(30)</FONT></TD></TR><TR><TD PORT="payment_date" ALIGN="LEFT"><FONT POINT-SIZE="12">payment_date : timestamptz</FONT></TD></TR><TR><TD PORT="received_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK received_by : bigint</FONT></TD></TR><TR><TD PORT="notes" ALIGN="LEFT"><FONT POINT-SIZE="12">notes : text</FONT></TD></TR></TABLE>>];
checkout_records [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>checkout_records</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id : bigint</FONT></TD></TR><TR><TD PORT="deposit_snapshot" ALIGN="LEFT"><FONT POINT-SIZE="12">deposit_snapshot : numeric(12,2)</FONT></TD></TR><TR><TD PORT="outstanding_snapshot" ALIGN="LEFT"><FONT POINT-SIZE="12">outstanding_snapshot : numeric(14,2)</FONT></TD></TR><TR><TD PORT="damage_amount" ALIGN="LEFT"><FONT POINT-SIZE="12">damage_amount : numeric(12,2)</FONT></TD></TR><TR><TD PORT="settled_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK settled_by : bigint</FONT></TD></TR><TR><TD PORT="settled_at" ALIGN="LEFT"><FONT POINT-SIZE="12">settled_at : timestamptz</FONT></TD></TR><TR><TD PORT="notes" ALIGN="LEFT"><FONT POINT-SIZE="12">notes : text</FONT></TD></TR></TABLE>>];
maintenance_requests [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>maintenance_requests</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK contract_id : bigint</FONT></TD></TR><TR><TD PORT="submitted_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK submitted_by : bigint</FONT></TD></TR><TR><TD PORT="assigned_to" ALIGN="LEFT"><FONT POINT-SIZE="12">FK assigned_to : bigint</FONT></TD></TR><TR><TD PORT="title" ALIGN="LEFT"><FONT POINT-SIZE="12">title : varchar(150)</FONT></TD></TR><TR><TD PORT="description" ALIGN="LEFT"><FONT POINT-SIZE="12">description : text</FONT></TD></TR><TR><TD PORT="priority" ALIGN="LEFT"><FONT POINT-SIZE="12">priority : varchar(20)</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="12">status : varchar(20)</FONT></TD></TR><TR><TD PORT="expected_date" ALIGN="LEFT"><FONT POINT-SIZE="12">expected_date : date</FONT></TD></TR><TR><TD PORT="actual_cost" ALIGN="LEFT"><FONT POINT-SIZE="12">actual_cost : numeric(12,2)</FONT></TD></TR><TR><TD PORT="progress_note" ALIGN="LEFT"><FONT POINT-SIZE="12">progress_note : text</FONT></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT"><FONT POINT-SIZE="12">created_at : timestamptz</FONT></TD></TR></TABLE>>];
maintenance_images [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1"><TR><TD BGCOLOR="#E9EEF3"><B>maintenance_images</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="12">PK id : bigint</FONT></TD></TR><TR><TD PORT="maintenance_request_id" ALIGN="LEFT"><FONT POINT-SIZE="12">FK maintenance_request_id : bigint</FONT></TD></TR><TR><TD PORT="url" ALIGN="LEFT"><FONT POINT-SIZE="12">url : text</FONT></TD></TR><TR><TD PORT="uploaded_by" ALIGN="LEFT"><FONT POINT-SIZE="12">FK uploaded_by : bigint</FONT></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT"><FONT POINT-SIZE="12">created_at : timestamptz</FONT></TD></TR></TABLE>>];
contracts:id -> checkout_records:contract_id [dir=both, arrowtail=tee, arrowhead=tee];
users:id -> checkout_records:settled_by [dir=both, arrowtail=tee, arrowhead=crow];
